// malariafwd_vivax.slim: the model the malariafwd R package runs, an individual-based forward
// simulation of Plasmodium vivax transmission and genetics
// (https://github.com/shaziaruybal/malariafwd). One SLiM individual is one parasite genome (a
// dormant one stands for a batch of identical hypnozoites); each human host and each mosquito is a
// subpopulation.
//
// It needs SLiM 5.2 or newer, which initialize() checks. Each parameter is given with -d NAME=value
// and otherwise takes the default set in initialize(). The run's random numbers come from the SEED
// parameter (default 55), not from slim's -s: run_sim() passes the same seed both ways, so that the
// tree sequence's provenance, which records -s, agrees with params.tsv. run_sim() starts the model
// in the run's directory with OUTDIR '.', the directory the outputs go to, which must exist; the
// run's cmdline.txt holds the arguments it gave slim. It also passes the package version as
// MALARIAFWD_VERSION, which params.tsv records.
//
// Part of malariafwd, released under the MIT licence (the package's LICENSE). To cite it, use
// citation("malariafwd") in R, and please also cite SLiM (Haller et al. 2025; Haller et al. 2019)
// and tskit (Kelleher et al. 2018).
//
// The model description (https://shaziaruybal.github.io/malariafwd/MODEL_DESCRIPTION.html)
// describes the model, and its section 21 lists the works cited here by author and year. The
// decision log (https://shaziaruybal.github.io/malariafwd/DECISIONS.html) gives the reasons for the
// model's choices; the D numbers in these comments (D17, D25, ...) refer to it.
//
// One tick is one day, in SLiM's nonWF order:
//   reproduction()  relapses; the hypnozoite batch of an import that arrived the day before (D17);
//                   bites, which carry parasites both ways, with meiosis in the mosquito;
//                   recrudescences. On day 2 a second callback gives each founder host that shares a
//                   founding genome its copy. Neither runs on a day with no parasite.
//   early()         on day 1 first, the founders and the output files. Then every day: emptied
//                   hypnozoite batches, and the subpatent clones that recrudesced, are removed;
//                   courses that are due are given; blood-stage clones clear; mosquitoes die and are
//                   replaced; an MDA round on MDA_TICK; imports arrive; and the run ends early if no
//                   parasite is left and none can still come.
//   late()          the day's rows of state.tsv; on the last day, also the tree sequence
//                   (plasmo.trees).
// Events are written to events.tsv as they happen.

initialize() {

	// ── DEFAULTS, for a parameter not given with -d (run_sim() gives every one) ──
	defineDefault("SIM_ID",                  "default");
	defineDefault("SEED",                    55);
	defineDefault("SIM_DAYS",                365); // 365 days or one year
	defineDefault("N_HOSTS",                 40);
	defineDefault("N_FOUNDER_HOSTS",         12); // hosts infected at the start (establishment: does the epidemic sustain?). Hold it fixed to vary diversity alone.
	defineDefault("N_FOUNDER_LINEAGES",      N_FOUNDER_HOSTS); // number of DISTINCT founding genomes among those hosts (<= N_FOUNDER_HOSTS). The clean GENEALOGICAL diversity knob: fewer lineages -> more hosts carry clonal copies -> higher background relatedness, at fixed establishment.
	defineDefault("N_MOSQ",                  100);
	
	// epi
	defineDefault("BITING_RATE",             0.1); // per-MOSQUITO daily biting probability (drawn in reproduction() as P(this mosquito bites today)). The Ross-Macdonald per-human rate ma = BITING_RATE * N_MOSQ / N_HOSTS, NOT this value directly.
	defineDefault("P_TRANS_VH",              0.5); // b = probability an infectious mosquito bite infects a human
	defineDefault("P_TRANS_HV",              0.5); // c = probability a mosquito becomes infected after biting an infected human
	defineDefault("MOSQ_LIFESPAN",           10.0); // expected mosquito lifespan 10 days
	defineDefault("EIP_DAYS",                10); // extrinsic incubation period mosquito
	defineDefault("MAX_MOI",                 20); // SUPERINFECTION GATE, not a hard ceiling on MOI. Checked the same way for every new inoculation, a local bite (whatever the host's infectious state) or an import (D38): a host already carrying MAX_MOI blood-stage lineages, patent or subpatent, has the WHOLE inoculation skipped (blood-stage primary AND its hypnozoite batch, so the reservoir also stops being topped up). At least 1; 1 means no superinfection. RELAPSES BYPASS IT - hypnozoite activation has no MAX_MOI check - so realised MOI can exceed this value. At the default of 20 it is a runaway guard that essentially never binds (COI is typically 1-3); set it low and you are measuring the cap, not the biology.
	defineDefault("MAX_BROODS_PER_MOSQ",     20); // a mosquito carrying this many lineages takes up no more (one uptake can add up to four per oocyst, so the count can pass it); carrying many costs it nothing, as its survival and infectiousness do not depend on them
	
	// parasite
	defineDefault("MEAN_BLOOD_STAGE_DURATION", 60.0);
	// mosquito uptake / inoculation sampling (after Wong et al. 2018).
	// !! LAMBDA_* IS THE PRE-TRUNCATION RATE, NOT THE MEAN COUNT. Conditioning away the zeros
	// pulls the realised mean UP, so lambda canNOT be read straight off a paper's reported
	// mean oocyst count. Poisson: realised mean = lambda/(1-exp(-lambda)) -> lambda=1 gives
	// 1.58, lambda=2 gives 2.31. The NB case (K_OOCYSTS > 0) shifts it further: lambda=2,K=1
	// gives a realised mean of 3.0. Use the R helpers uptake_moments(lambda, k) to see what a
	// setting produces, and uptake_calibrate(mean, var) to convert a TARGET realised mean (and
	// variance) from the literature into the lambda / K to set here.
	// Zero-truncation is correct because P_TRANS_HV / P_TRANS_VH already decide whether the
	// event succeeds - allowing 0 would count a failure twice.
	// DEFAULT lambda = 0 -> exactly 1 (single oocyst per uptake, single genotype per bite).
	// NOTE: vivax membrane-feeding oocyst counts are OVERDISPERSED
	// (a zero-inflated negative binomial describes 96 P. vivax direct membrane-feeding assays of
	// 22,236 mosquitoes: Miura et al. 2020), so treat LAMBDA_OOCYSTS > 0 as a sensitivity knob;
	// K_OOCYSTS below makes the count negative binomial.
	defineDefault("LAMBDA_OOCYSTS",          0.0); // oocysts formed per successful uptake (each oocyst = one independent gamete pair + meiosis)
	defineDefault("LAMBDA_SPOROZOITES",      0.0); // oocyst products sampled (with replacement) per infectious bite; repeat draws of a lineage collapse to one inoculated genotype
	// Oocyst-count OVERDISPERSION. K_OOCYSTS <= 0 (default) = Poisson; K_OOCYSTS > 0 = negative
	// binomial with var = lambda + lambda^2/K (Gamma-Poisson mixture), so Poisson is the
	// K -> infinity limit and this is a strict superset of the Poisson case. NOTE we deliberately
	// do NOT add zero-INFLATION: P_TRANS_HV already decides whether uptake succeeds, so the
	// zeros in a membrane-feeding dataset are already represented - inflating here would
	// double-count them. Between-donor gametocytaemia variation is likewise already emergent.
	// K_OOCYSTS therefore captures only the RESIDUAL within-feed overdispersion.
	defineDefault("K_OOCYSTS",               0.0); // NB dispersion for the oocyst count; 0 = Poisson
	// GAMETOCYTE gating. A blood-stage infection becomes transmissible to
	// mosquitoes only from gametocyte_ready_tick = bloodstage_start + GAMETOCYTE_DELAY,
	// and only if it carries gametocytes (per-infection roll, prob P_GAMETOCYTE).
	// DEFAULTS = identity (immediate, always-gametocytemic), so the gate does nothing unless
	// set; these knobs exist for sensitivity analysis. P. vivax gametocytes appear
	// early (at/near symptom onset, unlike ~10-12 d in P. falciparum), so a realistic
	// preset is a SHORT delay + high carriage, e.g. GAMETOCYTE_DELAY=3, P_GAMETOCYTE=0.9.
	defineDefault("GAMETOCYTE_DELAY",        0);   // days blood-stage -> transmissible (0 = immediate; vivax realistic ~2-3)
	defineDefault("P_GAMETOCYTE",            1.0); // P(an active infection is gametocytemic/transmissible); 1.0 = all

	// genome (PvP01; see the GENOME block in initialize()). GENOME_MODE is a pure
	// COORDINATE/extent switch: "full" (full PvP01 chromosome lengths, 24.2 Mb) or "core"
	// (subtelomere-masked lengths). BOTH use the same uniform recombination rate 7.4e-7/bp,
	// so the modes differ only in which sequence we keep. DEFAULT = "full": the model is
	// fully NEUTRAL (mutation rate 0; all genetics from the ground-truth genealogy), so
	// there is no genotyping/alignment reason to mask subtelomeres - the complete physical
	// scaffold is the honest representation. "core" mimics a real subtelomere-masked panel.
	// CHROMOSOMES: which of the 14 to simulate, e.g. "1-14" (all), "1,3,5", "5-8".
	// RECOMB_RATE > 0 overrides the per-bp within-chromosome crossover rate.
	defineDefault("GENOME_MODE",   "full");
	defineDefault("CHROMOSOMES",   "1-14");
	defineDefault("RECOMB_RATE",   -1.0);
	
	// hypnozoite: the batch model of White et al. (2014). Every transmitted genotype
	// independently rolls (1) whether it causes an active primary infection (P_PRIMARY) and
	// (2) how many hypnozoites it establishes, as a single "batch" object (geometric, mean
	// NU_HYPNOZOITE_BATCH per bite, split among the genotypes the bite delivers) - both,
	// either, or neither can occur for the same transmitted genotype.
	defineDefault("P_PRIMARY",               1.0); // P(transmitted genotype causes an active primary infection); the base model of White et al. (2014) treats this as certain given a successful inoculation
	defineDefault("NU_HYPNOZOITE_BATCH",     3.0); // mean hypnozoite batch size per infectious bite (geometric distribution, as in White et al. 2014); fitted to four target bands at moderate transmission (D48; inst/validation/calibrate_nu.R), to re-fit per setting
	defineDefault("ALPHA_ACTIVATE",          1/170.0); // hypnozoite activation rate per day: an average carriage of about 170 days (Mehra et al. 2024b); White et al. (2014) estimate 1/332
	defineDefault("MU_HYPNOZOITE",           1/442.0); // hypnozoite death rate per day, as in Mehra et al. (2024a), who credit White et al. (2014), whose table gives 1/425
	defineDefault("K_LATENCY",               0); // 0 = tropical, 2 = temperate
	defineDefault("DELTA_LATENCY",           1/100.0); // latency progression rate (only used if K_LATENCY > 0)
	
	// VECTOR-CONTROL interventions (off by default). These scale the BITING RATE only: not
	// importation, whose infections were acquired elsewhere (D46), and never case management,
	// which is TREATMENT_START/END below (D19).
	defineDefault("INTERVENTION_START",      99999); // these interventions affect transmission (eg biting rates)
	defineDefault("INTERVENTION_END",        99999);
	defineDefault("INTERVENTION_EFFICACY",   0.0);

	// CASE MANAGEMENT window (D19), separate from the vector-control window INTERVENTION_*, so
	// treatment can run without a change in biting. Defaults are "always on", so a coverage
	// alone is sufficient: RADCURE_COVERAGE / BLOODCURE_COVERAGE are the switches.
	// The window gates when a case is DECIDED (presents and is prescribed), not when the
	// drugs land. A case detected just before TREATMENT_END still completes its course
	// TREATMENT_DELAY days later, which may fall outside the window - a patient who presents
	// on the programme's last day is not refused treatment.
	defineDefault("TREATMENT_START",         0);
	defineDefault("TREATMENT_END",           99999);

	// seasonality: effective biting = BITING_RATE * (1 + SEASONAL_AMP*cos(2pi(t-SEASONAL_PHASE)/365)).
	// SEASONAL_AMP 0 = no seasonality (default); ~0.85 = strong annual peaks
	// (biting swings ~0.15x..1.85x the mean). Clamped >= 0. SEASONAL_PHASE = day-of-year of the
	// PEAK (the cosine peaks at t = SEASONAL_PHASE).
	defineDefault("SEASONAL_AMP",    0.0);
	defineDefault("SEASONAL_PHASE",  0.0);

	// detection / observation layer: a true blood-stage episode becomes a DETECTED
	// (reported, genotyped) case w.p. P_DETECT_[type]. Relapses are mostly sub-patent
	// (immunity -> lower density), so set their rate lower. Detected cases form the
	// observed line list + the genotyped sample, and during the case-management window (D19)
	// a detected case can be treated: blood-stage (schizonticidal) treatment at coverage
	// BLOODCURE_COVERAGE (efficacy 1 - P_BLOODCURE_SURVIVAL, clears the active infection), with
	// radical cure (LIVER-stage, efficacy 1 - P_RAD_SURVIVAL, clears the hypnozoite reservoir)
	// for a fraction RADCURE_COVERAGE of those treated. Defaults: detect everything, treat nothing.
	defineDefault("P_DETECT_PRIMARY", 1.0);   // primaries + imports
	defineDefault("P_DETECT_RELAPSE", 1.0);   // relapses (set lower, e.g. 0.15)
	// CASE MANAGEMENT. A detected case is treated w.p. BLOODCURE_COVERAGE; radical cure is
	// NESTED inside that, so RADCURE_COVERAGE is P(radical cure | blood-stage treatment).
	// In practice primaquine is never given without a schizonticide.
	defineDefault("BLOODCURE_COVERAGE", 0.0); // P(a detected case is treated)
	defineDefault("RADCURE_COVERAGE", 0.0);   // P(radical cure | treated) - LIVER stage only
	defineDefault("P_BLOODCURE_SURVIVAL", 0.0); // P(a blood-stage clone survives treatment)
	// ---- THREE-STATE RECURRENCE: relapse / reinfection / RECRUDESCENCE (D25) ----
	// A clone that SURVIVES a blood-stage course may be suppressed below patency rather than
	// carrying on at full density. A subpatent clone is undetectable and is not an episode,
	// but it is still present and still (partly) infectious; after a delay it re-expands to
	// patency as a RECRUDESCENCE, which mints a new genome clonal to the holder, unless an MDA
	// round clears it first (D44). Natural clearance while subpatent is OFF, so without MDA
	// P_RECRUD_GIVEN_FAIL is exactly P(recrudescence | the course failed) and maps onto a WHO
	// therapeutic-efficacy failure rate. At 0.0, the default, a failed course leaves the
	// clone fully patent.
	defineDefault("P_RECRUD_GIVEN_FAIL", 0.0);
	// Mean days suppressed before re-expansion, and the shape of that waiting time.
	//
	// GEOMETRIC by default (D32): each day after the suppression the clone re-expands with
	// probability 1/MEAN_RECRUD_DELAY, so the delay is at least one day with this mean. It is
	// the discrete analogue of the Exponential that the only published fit for this quantity
	// uses. Taylor et al. (2019) model time-to-recrudescence as exponential; the ceiling of an
	// exponential on a day scale is exactly a geometric (their own simulator rounds instead,
	// round(rexp(1, 1/10)), which differs only in the mass at 0). Every other duration in the
	// model is geometric too (D29).
	//
	// 10.5 d is a literature assumption, pending parameterisation (D42): the reciprocal of the
	// posterior median of Taylor et al. (2019), which sits on their strongly informative
	// Gamma(100, 1000) prior (mean 0.1/day), so it is not an estimate from data. It keeps
	// recrudescences inside a standard 28-day WHO therapeutic-efficacy window, where a real study
	// can see them: the median gap is 7 d and ~94% land inside day 28.
	//
	// "poisson" is 1 + Poisson(mean - 1), a tight-window sensitivity arm; "fixed" is
	// round(mean) days, halves rounded up (11 at 10.5), for debugging and sensitivity. Every
	// shape is at least one day.
	defineDefault("MEAN_RECRUD_DELAY", 10.5);
	defineDefault("RECRUD_DELAY_DIST", "geometric");
	// Detection of a recrudescent episode. Ross et al. (2025) put recurrence detectability at
	// 0.13-0.49 of a primary, so this should usually be set well below P_DETECT_PRIMARY.
	defineDefault("P_DETECT_RECRUD", 0.5);
	// Infectiousness of a SUBPATENT clone relative to a patent one. 0.035-0.10 in the
	// individual-based model of White et al. (2018); 0.10-0.20 from the mosquito-feeding studies
	// compiled by Koepfli et al. (2021, their Fig 5: microscopy-positive carriers 5-10x more
	// infective than submicroscopic ones, a P. vivax study in Brazil the exception). NOT 0:
	// submicroscopic carriage is a real transmission reservoir.
	defineDefault("SUBPATENT_INFECTIVITY", 0.15);
	// Days from blood-stage emergence to receiving drugs: symptom onset + care seeking +
	// diagnosis. Drawn once per course: each day after the case the course arrives with
	// probability 1/TREATMENT_DELAY, so the delay is geometric on 1, 2, ... with this mean
	// (White et al. 2014 use 7). Must be >= 1; 1 = the next day, the fastest response the model can
	// represent (D24, D32).
	// Treatment is NOT instantaneous: a treated case is infectious until its drugs arrive.
	defineDefault("TREATMENT_DELAY", 7.0);

	// Resurgence trigger: applies from RESURGENCE_TRIGGER_TICK onward (never,
	// by default) as multiplicative boosts on top of whatever value the
	// parameter already has - lets a single scenario run a quiet baseline
	// period and then "switch on" one specific mechanism (transmission,
	// relapse reservoir, or both) without changing anything else about the
	// baseline. All default to 1.0 (no boost).
	defineDefault("RESURGENCE_TRIGGER_TICK",      99999);
	defineDefault("BITING_RATE_BOOST",            1.0);  // transmission-driven resurgence
	defineDefault("ALPHA_ACTIVATE_BOOST",         1.0);  // relapse-driven: faster activation
	defineDefault("NU_HYPNOZOITE_BATCH_BOOST",    1.0);  // relapse-driven: bigger hypnozoite batches
	defineDefault("MDA_TICK",        99999);
	// Fraction of the population a round actually reaches. Coverage is the whole policy question
	// for MDA - it is what distinguishes a feasible campaign from an idealised one - and without
	// it a round is all-or-nothing, which is not a scenario anyone runs. At 1.0 the draw is
	// skipped, so a round that reaches everyone uses no random numbers.
	defineDefault("MDA_COVERAGE",    1.0);
	// RADICAL CURE EFFICACY, per PERSON: P_RAD_SURVIVAL is the probability that the whole
	// reservoir survives a course. 0.29 (~71% cure) is near the 70% effectiveness White et al.
	// (2018) assume for a 14-day primaquine course, given poor adherence.
	//
	// RADCURE_MODE selects the unit:
	//   "person"     (default) all-or-nothing - the reservoir is cleared or it is not. This is
	//                how clinical efficacy is reported (recurrence prevented per patient).
	//   "hypnozoite" EXPERIMENTAL. Each hypnozoite survives independently w.p. P_RAD_SURVIVAL,
	//                so efficacy falls as the reservoir grows and treatment can clear PART of
	//                it. That partial clearance is the only way a subset of genotypes survives
	//                treatment, which is what reshapes post-treatment relapse diversity - the
	//                reason this mode is kept. Note P_RAD_SURVIVAL then means something
	//                different (per hypnozoite), so the same number is NOT the same efficacy.
	defineDefault("P_RAD_SURVIVAL",  0.29);
	defineDefault("RADCURE_MODE",    "person");
	
	// importation (off by default)
	defineDefault("IMPORT_START", 99999);
	defineDefault("IMPORT_END", 99999);
	defineDefault("N_IMPORTS_PER_TICK", 0);
	// Stochastic alternative to N_IMPORTS_PER_TICK: a genuine arrival RATE
	// (mean imports per tick, e.g. 0.25 = "on average 1 every 4 days"),
	// realized each tick as a Poisson draw rather than a guaranteed fixed
	// count - a much more realistic "leaky border" than a deterministic
	// schedule. Additive with N_IMPORTS_PER_TICK if both are set (the
	// latter stays available for anyone who wants a hard guaranteed floor).
	defineDefault("IMPORT_RATE_PER_TICK", 0.0);
	// import-driven resurgence: multiplies IMPORT_RATE_PER_TICK from
	// RESURGENCE_TRIGGER_TICK onward (the "leaky border opens wider"), matching the
	// BITING_RATE_BOOST / ALPHA_ACTIVATE_BOOST pattern. 1.0 = no boost.
	defineDefault("IMPORT_RATE_BOOST", 1.0);
	// single importation event params 
	defineDefault("IMPORT_TICK", 99999);
	defineDefault("N_IMPORTS", 0);
	
	// output
	defineDefault("OUTDIR", "output/default_run"); // the output directory, which must exist
	// VERBOSE: T = print the full per-event / per-tick narration (~30k lines/run, useful for
	// debugging a single run); F (default) = quiet, only the GENOME line, WARNINGs, and the
	// SIMULATION FINISHED banner. Does NOT affect results or the data files (events/state/trees),
	// only console/log narration. Recommended F for sweeps (cuts log-disk noise).
	defineDefault("VERBOSE", F);

	// tree-sequence recording. T = permanently retain cleared/dead infections (hypnozoite
	// batches + cleared blood-stage broods) in the tree sequence so IBD can be computed between a
	// recurrence and an EARLIER, already-cleared infection (relapse-to-prior,
	// attribution networks, WHO-vs-genetics reclassification all need this).
	// F = retain them without the permanent flag (permanent=F): cleared infections may be
	// simplified away, losing their ancestry - only safe when IBD to prior
	// infections is NOT needed.
	defineDefault("RETAIN_FULL_HISTORY", T);

	// ── PARAMETER TYPES, for runs started directly with -d (D45) ────────────
	// validate_params() checks every parameter's type before SLiM starts; a run started with -d
	// bypasses R, so the same checks are made here. A number may be written either way, 7 or 7.0,
	// and gives the same run (the model converts it where Eidos needs one type); a count or a day
	// must also be a whole number.
	if (exists("N_FOUNDERS"))
		stop("N_FOUNDERS is not a parameter: set N_FOUNDER_HOSTS, the hosts infected at the start, and " +
			"N_FOUNDER_LINEAGES, the distinct founding genomes among them (it defaults to N_FOUNDER_HOSTS).");
	if (exists("N_OOCYSTS_PER_BITE"))
		stop("N_OOCYSTS_PER_BITE is not a parameter: the products a bite delivers are set by " +
			"LAMBDA_SPOROZOITES, the mean of their zero-truncated count (0 gives exactly one).");
	whole_params = c("SIM_DAYS", "N_HOSTS", "N_FOUNDER_HOSTS", "N_FOUNDER_LINEAGES",
		"N_MOSQ", "EIP_DAYS", "MAX_MOI", "MAX_BROODS_PER_MOSQ",
		"GAMETOCYTE_DELAY", "K_LATENCY", "INTERVENTION_START", "INTERVENTION_END", "TREATMENT_START",
		"TREATMENT_END", "MDA_TICK", "RESURGENCE_TRIGGER_TICK", "IMPORT_START", "IMPORT_END",
		"N_IMPORTS_PER_TICK", "IMPORT_TICK", "N_IMPORTS", "SEED");
	real_params = c("BITING_RATE", "P_TRANS_VH", "P_TRANS_HV", "MOSQ_LIFESPAN",
		"MEAN_BLOOD_STAGE_DURATION", "LAMBDA_OOCYSTS", "LAMBDA_SPOROZOITES", "K_OOCYSTS",
		"P_GAMETOCYTE", "P_PRIMARY", "NU_HYPNOZOITE_BATCH", "ALPHA_ACTIVATE", "MU_HYPNOZOITE",
		"DELTA_LATENCY", "RECOMB_RATE", "INTERVENTION_EFFICACY", "P_RAD_SURVIVAL", "RADCURE_COVERAGE",
		"BLOODCURE_COVERAGE", "P_BLOODCURE_SURVIVAL", "MDA_COVERAGE", "P_RECRUD_GIVEN_FAIL",
		"MEAN_RECRUD_DELAY", "P_DETECT_RECRUD", "SUBPATENT_INFECTIVITY", "TREATMENT_DELAY",
		"P_DETECT_PRIMARY", "P_DETECT_RELAPSE", "SEASONAL_AMP", "SEASONAL_PHASE", "BITING_RATE_BOOST",
		"ALPHA_ACTIVATE_BOOST", "NU_HYPNOZOITE_BATCH_BOOST", "IMPORT_RATE_PER_TICK", "IMPORT_RATE_BOOST");
	flag_params = c("VERBOSE", "RETAIN_FULL_HISTORY");
	text_params = c("SIM_ID", "OUTDIR", "GENOME_MODE", "CHROMOSOMES", "RADCURE_MODE", "RECRUD_DELAY_DIST");
	for (nm in c(whole_params, real_params, flag_params, text_params))
	{
		v = executeLambda(nm + ";");
		if (size(v) != 1)
			stop(nm + " must be a single value, got " + size(v) + " values.");
		if (match(nm, flag_params) >= 0)
		{
			if (!isLogical(v))
				stop(nm + " must be T or F, got " + shown(v));
		}
		else if (match(nm, text_params) >= 0)
		{
			if (!isString(v))
				stop(nm + " must be a string, quoted as in -d \"" + nm + "='...'\", got " + shown(v));
		}
		else if (!(isInteger(v) | isFloat(v)))
			stop(nm + " must be a number, got " + shown(v));
		// nested ifs, not `&`: Eidos does not short-circuit, and round() refuses an integer
		else if (match(nm, whole_params) >= 0)
		{
			if (isFloat(v))
			{
				if (!(abs(v) < INF))
					stop(nm + " must be finite, got " + shown(v));
				if (v != round(v))
					stop(nm + " must be a whole number, got " + shown(v));
			}
			if (!(abs(v) <= 2^53))
				stop(nm + " must lie within +/- 2^53 (about 9e15), got " + shown(v));
		}
	}

	// ── DERIVED CONSTANTS (always computed from above) ────────────
	defineConstant("MU_MOSQ",       1/MOSQ_LIFESPAN); // daily mosquito mortality rate
	defineConstant("P_BLOOD_CLEAR", 1/MEAN_BLOOD_STAGE_DURATION); // daily clearance prob: a geometric duration, mean MEAN_BLOOD_STAGE_DURATION days
	if (LAMBDA_OOCYSTS < 0 | LAMBDA_SPOROZOITES < 0)
		stop("LAMBDA_OOCYSTS and LAMBDA_SPOROZOITES must be >= 0");
	// The checks below are mirrored in validate_params() and repeated here for runs started
	// directly with -d. They are written as comparisons rather than isFinite(), which refuses
	// the integer that -d X=7 produces, and so that NAN fails them. The caps allow a little more
	// rounding than validate_params() does, since the values arrive rounded to 15 digits, so a set
	// R accepts is never refused here.
	// drawZTCount() mixes Poissons over Gamma(lambda, K) rates. At a given mean, the tries an
	// uptake takes grow about as 1 / K below K = 1e-3, and so does the exact draw that follows
	// 10,000 failed tries (about lambda / K terms). Without this floor both grow without bound as K
	// falls (lambda 1000 with K 1e-9 would take about 6e12 terms), and lambda / K overflows below K
	// of about 5.6e-306. K = 1e-3 already gives a variance within 0.5% of the K -> 0 limit at the
	// same mean.
	if (!(K_OOCYSTS == 0 | (K_OOCYSTS >= 1e-3 * (1 - 1e-11) & K_OOCYSTS < INF)))
		stop("K_OOCYSTS must be 0 (Poisson) or at least 0.001 and finite, got " + K_OOCYSTS +
			((K_OOCYSTS > 0 & K_OOCYSTS < 1e-3) ? ": below that the oocyst draws take ever more work." else "."));
	// validate_params() caps the mean oocyst count per uptake at 1000, which caps lambda too; with
	// K at least 1e-3 this keeps every gamma rate finite.
	if (!(LAMBDA_OOCYSTS <= 1000 * (1 + 1e-11) & LAMBDA_SPOROZOITES <= 1000 * (1 + 1e-11)))
		stop("LAMBDA_OOCYSTS and LAMBDA_SPOROZOITES must be at most 1000");
	// ...and the mean itself, as uptake_moments() works it out: a small K gives a heavy tail whose
	// mean, and so the work per uptake, can be many times lambda.
	if (LAMBDA_OOCYSTS > 0)
	{
		// the same branches as uptake_moments(): x is -log P(0), and the series stand in for
		// k log(1 + r) and 1 - exp(-x) where those round to 0 (a tiny lambda, or a huge K)
		lam = asFloat(LAMBDA_OOCYSTS);
		r_ooc = (K_OOCYSTS > 0) ? lam / K_OOCYSTS else 0.0;
		x0 = (K_OOCYSTS > 0) ? ((r_ooc < 1e-8) ? lam * (1 - r_ooc / 2) else K_OOCYSTS * log(1 + r_ooc)) else lam;
		q0 = (x0 < 1e-8) ? x0 * (1 - x0 / 2) else 1 - exp(-x0);
		m_ooc = lam / q0;
		if (!(m_ooc <= 1000 * (1 + 1e-11)))
			stop("LAMBDA_OOCYSTS = " + shown(LAMBDA_OOCYSTS) + " with K_OOCYSTS = " + shown(K_OOCYSTS) +
				" gives a mean of " + shown(m_ooc) + " oocysts per successful uptake; the mean must be at most 1000.");
	}
	// These factors scale the biting, import and activation rates, which must stay non-negative
	// and finite (an infinite activation boost times ALPHA_ACTIVATE = 0 is NAN).
	if (!(INTERVENTION_EFFICACY >= 0 & INTERVENTION_EFFICACY <= 1))
		stop("INTERVENTION_EFFICACY must be in [0, 1], got " + INTERVENTION_EFFICACY);
	if (!(IMPORT_RATE_PER_TICK >= 0 & IMPORT_RATE_BOOST >= 0 & IMPORT_RATE_BOOST < INF &
		BITING_RATE_BOOST >= 0 & BITING_RATE_BOOST < INF))
		stop("IMPORT_RATE_PER_TICK, IMPORT_RATE_BOOST and BITING_RATE_BOOST must be >= 0 and finite");
	if (!(ALPHA_ACTIVATE_BOOST >= 0 & ALPHA_ACTIVATE_BOOST < INF))
		stop("ALPHA_ACTIVATE_BOOST must be >= 0 and finite, got " + ALPHA_ACTIVATE_BOOST);
	if (!(SEASONAL_AMP >= 0 & SEASONAL_AMP < INF))
		stop("SEASONAL_AMP must be >= 0 and finite (0 means no seasonality), got " + SEASONAL_AMP);
	// The peak daily import rate and hypnozoite batch mean: rpois() wraps above 2^32 and does not
	// return for a rate near 1e18, and rgeom() saturates near 4e9. A boost below 1 lowers a rate
	// only after the trigger, so the peak is then the unboosted rate.
	boost_in_run = (RESURGENCE_TRIGGER_TICK <= SIM_DAYS);
	if (!(IMPORT_RATE_PER_TICK * (boost_in_run ? max(1.0, asFloat(IMPORT_RATE_BOOST)) else 1.0) *
		(1 + SEASONAL_AMP) <= 1e6 * (1 + 1e-11)))
		stop("IMPORT_RATE_PER_TICK, times IMPORT_RATE_BOOST (if above 1) once the trigger falls inside " +
			"the run and 1 + SEASONAL_AMP at the seasonal peak, must be at most 1e6 imports a day");
	if (!(NU_HYPNOZOITE_BATCH * (boost_in_run ? max(1.0, asFloat(NU_HYPNOZOITE_BATCH_BOOST)) else 1.0) <=
		1e6 * (1 + 1e-11)))
		stop("NU_HYPNOZOITE_BATCH, times NU_HYPNOZOITE_BATCH_BOOST (if above 1) once the trigger falls " +
			"inside the run, must be at most 1e6 hypnozoites per bite");
	// The days that default to 99999 mean 'never', and a run this long would reach them.
	if (SIM_DAYS >= 99999)
	{
		never_names = c("INTERVENTION_START", "INTERVENTION_END", "TREATMENT_END", "MDA_TICK",
			"RESURGENCE_TRIGGER_TICK", "IMPORT_START", "IMPORT_END", "IMPORT_TICK");
		never_days = c(INTERVENTION_START, INTERVENTION_END, TREATMENT_END, MDA_TICK,
			RESURGENCE_TRIGGER_TICK, IMPORT_START, IMPORT_END, IMPORT_TICK);
		still_never = never_names[never_days == 99999];
		if (size(still_never) > 0)
			stop("SIM_DAYS = " + SIM_DAYS + " reaches day 99999, which the defaults use for 'never', and " +
				paste(still_never, sep=", ") + ((size(still_never) > 1) ? " are" else " is") +
				" still 99999: set each to a day after SIM_DAYS, or to the day you mean (in a run this " +
				"long, day 99999 itself cannot be used).");
	}
	// Each day after its trigger a delay ends with probability 1/D (D32), so D must be at least
	// 1; the cap of 1e6 days keeps the draws far below where they saturate (about 4e9 days).
	if (!(TREATMENT_DELAY >= 1 & TREATMENT_DELAY <= 1e6))
		stop("TREATMENT_DELAY must be >= 1 and finite (days, at most 1e6), got " + TREATMENT_DELAY +
			": a course arrives each day after the case with probability 1/TREATMENT_DELAY, so 1 means the next day.");
	if (!(MEAN_RECRUD_DELAY >= 1 & MEAN_RECRUD_DELAY <= 1e6))
		stop("MEAN_RECRUD_DELAY must be >= 1 and finite (days, at most 1e6), got " + MEAN_RECRUD_DELAY +
			": it is the mean delay from suppression to recrudescence, which is at least one day.");
	// At 0 the gate would refuse every inoculation, an empty host's included (D38).
	if (!(MAX_MOI >= 1))
		stop("MAX_MOI must be at least 1, got " + MAX_MOI + ": a host takes a new inoculation only " +
			"while it carries fewer than MAX_MOI blood-stage lineages, so 1 means no superinfection.");
	// The rest of validate_params()'s refusals (D45). Without them a direct run starts and means
	// something else (RADCURE_MODE = 'Person' would run the per-hypnozoite mode, and a probability
	// above 1 is always true) or stops part-way.
	for (nm in c("P_TRANS_VH", "P_TRANS_HV", "P_GAMETOCYTE", "P_PRIMARY", "P_DETECT_PRIMARY",
		"P_DETECT_RELAPSE", "RADCURE_COVERAGE", "P_RAD_SURVIVAL", "BLOODCURE_COVERAGE",
		"P_BLOODCURE_SURVIVAL", "P_RECRUD_GIVEN_FAIL", "P_DETECT_RECRUD", "SUBPATENT_INFECTIVITY",
		"MDA_COVERAGE", "ALPHA_ACTIVATE"))
	{
		v = executeLambda(nm + ";");
		if (!(v >= 0 & v <= 1))
			stop(nm + " must be in [0, 1], got " + shown(v));
	}
	for (nm in c("N_HOSTS", "N_MOSQ", "BITING_RATE"))
	{
		v = executeLambda(nm + ";");
		if (!(v > 0 & v < INF))
			stop(nm + " must be > 0 and finite, got " + shown(v));
	}
	for (nm in c("NU_HYPNOZOITE_BATCH", "NU_HYPNOZOITE_BATCH_BOOST", "N_IMPORTS", "N_IMPORTS_PER_TICK",
		"N_FOUNDER_HOSTS", "N_FOUNDER_LINEAGES", "EIP_DAYS", "GAMETOCYTE_DELAY",
		"MAX_BROODS_PER_MOSQ", "K_LATENCY"))
	{
		v = executeLambda(nm + ";");
		if (!(v >= 0 & v < INF))
			stop(nm + " must be >= 0 and finite, got " + shown(v));
	}
	if (!(abs(SEASONAL_PHASE) < INF))
		stop("SEASONAL_PHASE must be finite (the day of the year of the peak), got " + shown(SEASONAL_PHASE));
	if (!(RECOMB_RATE <= 0.5 & RECOMB_RATE > -INF))
		stop("RECOMB_RATE must be at most 0.5 per bp and finite, got " + shown(RECOMB_RATE) +
			" (a value <= 0 means the default map rate, 7.4e-7).");
	if (N_FOUNDER_HOSTS > N_HOSTS)
		stop("N_FOUNDER_HOSTS (" + N_FOUNDER_HOSTS + ") must be at most N_HOSTS (" + N_HOSTS + ").");
	if (N_FOUNDER_LINEAGES > N_FOUNDER_HOSTS)
		stop("N_FOUNDER_LINEAGES (" + N_FOUNDER_LINEAGES + ") must be at most N_FOUNDER_HOSTS (" +
			N_FOUNDER_HOSTS + "): each founder host carries one of the founding genomes.");
	if (!(MOSQ_LIFESPAN >= 1 & MOSQ_LIFESPAN < INF))
		stop("MOSQ_LIFESPAN must be >= 1 and finite (days), got " + shown(MOSQ_LIFESPAN) +
			": a mosquito dies each day with probability 1/MOSQ_LIFESPAN.");
	if (!(MEAN_BLOOD_STAGE_DURATION >= 1 & MEAN_BLOOD_STAGE_DURATION < INF))
		stop("MEAN_BLOOD_STAGE_DURATION must be >= 1 and finite (days), got " + shown(MEAN_BLOOD_STAGE_DURATION) +
			": blood-stage infections clear each day with probability 1/MEAN_BLOOD_STAGE_DURATION.");
	if (!(MU_HYPNOZOITE > 0 & MU_HYPNOZOITE <= 1))
		stop("MU_HYPNOZOITE must be in (0, 1], got " + shown(MU_HYPNOZOITE) + ": it is a daily probability, " +
			"and hypnozoites that cannot die keep their batch alive forever.");
	if (K_LATENCY > 0)
		if (!(DELTA_LATENCY > 0 & DELTA_LATENCY <= 1))
			stop("DELTA_LATENCY must be in (0, 1] when K_LATENCY > 0, got " + shown(DELTA_LATENCY) +
				": a latent batch leaves each latency stage with daily probability DELTA_LATENCY.");
	if (!(RADCURE_MODE == "person" | RADCURE_MODE == "hypnozoite"))
		stop("RADCURE_MODE must be 'person' or 'hypnozoite', got '" + RADCURE_MODE + "'");
	// A founder host carrying a copy of another founder's genome receives it on day 2 (D39), so a
	// day-1 round would clear its template first and leave the copy nothing to copy (D44).
	if (MDA_TICK == 1 & N_FOUNDER_LINEAGES < N_FOUNDER_HOSTS)
		stop("MDA_TICK must not be 1 when a founder host carries a copy of another founder's genome " +
			"(N_FOUNDER_LINEAGES < N_FOUNDER_HOSTS): the copies are seeded on day 2, so a round comes " +
			"on day 2 or later.");
	// a coverage set against a closed case-management window would give no treatment at all (D19)
	if ((RADCURE_COVERAGE > 0 | BLOODCURE_COVERAGE > 0) &
		(TREATMENT_END <= TREATMENT_START | TREATMENT_START > SIM_DAYS))
		stop("a treatment coverage is set but the case-management window is closed (TREATMENT_START = " +
			TREATMENT_START + ", TREATMENT_END = " + TREATMENT_END + ", SIM_DAYS = " + SIM_DAYS +
			"): no case would ever be treated.");
	// the peak daily biting probability must be a number, as validate_params() requires
	biting_boost = (RESURGENCE_TRIGGER_TICK <= SIM_DAYS) ? max(1.0, asFloat(BITING_RATE_BOOST)) else 1.0;
	if (!(BITING_RATE * (1 + SEASONAL_AMP) * biting_boost < INF))
		stop("BITING_RATE with its seasonal and resurgence multipliers overflows; check BITING_RATE, " +
			"BITING_RATE_BOOST and SEASONAL_AMP.");
	// every other number must be finite too, whatever it is used for (DELTA_LATENCY, say, while
	// K_LATENCY is 0), as validate_params() requires
	for (nm in real_params)
	{
		v = executeLambda(nm + ";");
		if (!(abs(v) < INF))
			stop(nm + " must be finite, got " + shown(v));
	}

	// ---- configurations that cannot produce a single parasite ----------------------------
	// Mirrored in validate_params() on the R side; repeated here because the model can be run
	// directly with -d, bypassing R entirely. Unchecked, these configurations would complete with
	// exit status 0 and an EMPTY event log, which is indistinguishable from a cell that simply saw
	// no transmission - the worst kind of failure in a 100-run sweep.
	// NOTE: unreachable in practice. SLiM evaluates tick-range expressions (the model has a
	// `1:(SIM_DAYS - 1) late()` event) BEFORE initialize() runs, so SIM_DAYS < 2 already dies
	// with "the tick expression contains an element that is out of range (0)". Kept because it
	// is the intent, states the real constraint, and would become live if that range changed.
	// validate_params() on the R side is what actually produces a readable message.
	if (SIM_DAYS < 2)
		stop("SIM_DAYS must be >= 2 (founder seeding completes on tick 2), got " + SIM_DAYS);
	if (!(RECRUD_DELAY_DIST == "geometric" | RECRUD_DELAY_DIST == "poisson" |
	      RECRUD_DELAY_DIST == "fixed"))
		stop("RECRUD_DELAY_DIST must be 'geometric', 'poisson' or 'fixed', got '" +
			RECRUD_DELAY_DIST + "'");
	if (N_FOUNDER_HOSTS > 0 & N_FOUNDER_LINEAGES < 1)
		stop("N_FOUNDER_LINEAGES must be >= 1 when N_FOUNDER_HOSTS > 0: " + N_FOUNDER_HOSTS +
			" founder host(s) cannot share 0 distinct genomes.");
	// The last day of the run on which an import can arrive, or 0 if none (D37). Imports arrive in
	// early(), which first runs on day 1: the pulse counts when N_IMPORTS > 0 and IMPORT_TICK is a
	// day from 1 to SIM_DAYS, and the window when it has a count or a rate and a day from
	// max(1, IMPORT_START) to min(IMPORT_END - 1, SIM_DAYS), the last of which it contributes. The
	// bootstrap check below and the liveness check at the end of early() both read it, so they
	// cannot disagree about whether an import is still to come; has_import_path() in R uses the same
	// days. Ternaries rather than min() and max(), which refuse a mix of integer and float.
	pulse_day = ((N_IMPORTS > 0) & (IMPORT_TICK >= 1) & (IMPORT_TICK <= SIM_DAYS)) ? IMPORT_TICK else 0;
	window_first = (IMPORT_START >= 1) ? IMPORT_START else 1;
	window_last = (IMPORT_END - 1 <= SIM_DAYS) ? IMPORT_END - 1 else SIM_DAYS;
	window_day = (((N_IMPORTS_PER_TICK > 0) | (IMPORT_RATE_PER_TICK > 0)) & (window_first <= window_last)) ?
		window_last else 0;
	defineConstant("LAST_IMPORT_DAY", (pulse_day >= window_day) ? pulse_day else window_day);
	// A naive population is legitimate (D17: importation can seed an empty population), but
	// only if an import path is actually open.
	defineConstant("HAS_IMPORT_PATH", LAST_IMPORT_DAY > 0);
	if (N_FOUNDER_HOSTS < 1 & !HAS_IMPORT_PATH)
		stop("nothing can start this run: N_FOUNDER_HOSTS is 0 and no importation is " +
			"configured inside the run. Set N_FOUNDER_HOSTS >= 1, or open an import path on a day " +
			"from 1 to SIM_DAYS (IMPORT_TICK + N_IMPORTS, or IMPORT_START/IMPORT_END with " +
			"N_IMPORTS_PER_TICK or IMPORT_RATE_PER_TICK).");

	setSeed(asInteger(SEED));
	
	// SLiM 5.2 is the supported version: 5.0 and 5.1 give different output for the same seed.
	if (version(F)[1] < 5.2)
		stop("malariafwd needs SLiM 5.2 or newer; this is SLiM " + version(F)[1] + ".");
	initializeSLiMModelType("nonWF");
	initializeSLiMOptions(keepPedigrees=T);   // lineage ids are pedigree ids throughout
	initializeTreeSeq();
	
	// ── GENOME: PvP01 (Auburn et al. 2016; GCA_900093555) 14 nuclear chromosomes ──
	// Modelled as ONE concatenated linkage group, with the within-chr crossover rate along each
	// chromosome and 0.5 at each of the 13 junctions. seedTetrad() discards the junction draws and
	// assorts the chromosomes itself, by meiosis I at each chromosome's centromere, so every
	// product changes parent at a junction with probability 1/2. One concatenated group keeps ONE
	// tree-sequence file for the tskit IBD pipeline. [To switch to SLiM's explicit
	// multi-chromosome mode later, call initializeChromosome() per chromosome; that emits
	// <name>/chromosome_N.trees per chromosome, so the R/tskit IBD code must then aggregate across
	// the 14 files.]
	initializeMutationType("m1", 0.5, "f", 0.0);
	m1.convertToSubstitution = T;

	// PvP01 full chromosome lengths (bp), chr 1..14; GenBank LT635612.1..LT635625.1
	defineConstant("PVP01_FULL", c(1021664, 956327, 896704, 1012024, 1524814, 1042791,
	                               1652210, 1761288, 2237066, 1548844, 2131221, 3182763,
	                               2093556, 3153402));
	// CORE (subtelomere-masked) lengths. APPROXIMATION = 90% of full length, a proxy
	// for the MalariaGEN Pv4 core genome (subtelomeric pir/vir-rich content excluded;
	// ~21.8 Mb core of the 24.2 Mb assembly), not the exact Pv4 core-region coordinates (D5).
	defineConstant("PVP01_CORE", asInteger(round(PVP01_FULL * 0.90)));
	// Where each chromosome's centromere sits, as a fraction of its length, chr 1..14: the centres
	// of the centromere features PVP01_CEN01..PVP01_CEN14 of the PvP01 annotation (Sanger/GeneDB,
	// released with Auburn et al. 2016). Meiosis I in seedTetrad() sends the two chromatids
	// carrying the same parent there to the same pair of products; "core" mode uses the same
	// fractions of its shortened chromosomes.
	defineConstant("PVP01_CEN_FRAC", c(0.6645, 0.1707, 0.7043, 0.5592, 0.5543, 0.3228, 0.7610,
	                                   0.6434, 0.4373, 0.6536, 0.7529, 0.3297, 0.4711, 0.6800));

	// which PvP01 chromosomes to simulate (default all 14); accepts "1-14","1,3,5","5-8"
	// validate_params()'s reading of CHROMOSOMES, spaces aside (it removes them): Eidos would read
	// '1e1' as 10 and '1 4' or '1-2-3' as 1, and run another genome.
	if (size(grep("^ *[0-9]+ *(- *[0-9]+ *)?(, *[0-9]+ *(- *[0-9]+ *)?)*$", CHROMOSOMES)) == 0)
		stop("CHROMOSOMES must be chromosome numbers 1-14, comma-separated, with low-high ranges, " +
			"e.g. '1-14' or '1-3,5'; got '" + CHROMOSOMES + "'");
	chr_idx = integer(0);
	for (tok in strsplit(CHROMOSOMES, ","))
	{
		parts = strsplit(tok, "-");
		if (size(parts) == 2)
		{
			// the ends are checked before the range is built, as validate_params() does: Eidos cannot
			// build a range of 1e11 entries, and would stop without naming CHROMOSOMES
			if (any(asFloat(parts) < 1) | any(asFloat(parts) > 14))
				stop("CHROMOSOMES out of range 1..14: " + CHROMOSOMES);
			// Eidos counts down a high-low range; validate_params() refuses one (D45)
			if (asInteger(parts[0]) > asInteger(parts[1]))
				stop("CHROMOSOMES has a range that runs high-low: " + CHROMOSOMES);
			chr_idx = c(chr_idx, asInteger(parts[0]):asInteger(parts[1]));
		}
		else
		{
			if (asFloat(tok) < 1 | asFloat(tok) > 14)
				stop("CHROMOSOMES out of range 1..14: " + CHROMOSOMES);
			chr_idx = c(chr_idx, asInteger(tok));
		}
	}
	if (any(chr_idx < 1) | any(chr_idx > 14))
		stop("CHROMOSOMES out of range 1..14: " + CHROMOSOMES);
	if (size(unique(chr_idx)) != size(chr_idx))
		stop("CHROMOSOMES lists a chromosome twice: " + CHROMOSOMES);

	is_core = (GENOME_MODE == "core");
	if (!is_core & (GENOME_MODE != "full"))
		stop("GENOME_MODE must be 'core' or 'full', got: " + GENOME_MODE);
	chrlens = (is_core ? PVP01_CORE else PVP01_FULL)[chr_idx - 1];
	// within-chr crossover rate: 7.4e-7 /bp (13.5 kb/cM) for BOTH modes - the euchromatic
	// (subtelomere-excluded) core rate, Jiang et al. 2011 P. falciparum. Since the genome
	// is neutral and the map is uniform (not spatially varying), the core/euchromatic rate
	// is the right representative rate everywhere: the genome-wide 9.6 kb/cM figure is only
	// higher because it averages in hyper-recombinogenic subtelomeres we are not modelling
	// spatially. GENOME_MODE is therefore a pure COORDINATE/extent switch (full vs core
	// lengths), leaving full & core directly comparable. RECOMB_RATE > 0 overrides.
	within_r = (RECOMB_RATE > 0) ? RECOMB_RATE else 7.4e-7;

	// build the concatenated recombination map: within-chr rate + 0.5 at each junction
	rec_ends = integer(0); rec_rates = float(0); gpos = 0; chr_starts = integer(0);
	for (i in seqAlong(chrlens))
	{
		L = chrlens[i];
		chr_starts = c(chr_starts, gpos);
		if (i > 0)  // 1-bp junction to the previous chromosome; seedTetrad() discards its draws
		{
			rec_ends = c(rec_ends, gpos);
			rec_rates = c(rec_rates, 0.5);
		}
		rec_ends = c(rec_ends, gpos + L - 1);   // interior of chromosome i
		rec_rates = c(rec_rates, within_r);
		gpos = gpos + L;
	}
	defineConstant("GENOME_LENGTH", gpos);
	// first position of each chromosome on the concatenated map, and its centromere's position
	defineConstant("CHROM_STARTS", chr_starts);
	defineConstant("CHROM_CENTROMERES", chr_starts + asInteger(round(PVP01_CEN_FRAC[chr_idx - 1] * chrlens)));
	defineConstant("N_CHROMOSOMES", size(chrlens));
	defineConstant("RECOMB_WITHIN", within_r);

	initializeChromosome(1, GENOME_LENGTH, "H");
	initializeGenomicElementType("g1", m1, 1.0);
	initializeGenomicElement(g1, 0, GENOME_LENGTH - 1);
	initializeMutationRate(0.0);
	initializeRecombinationRate(rec_rates, rec_ends);
	catn("GENOME: mode=" + GENOME_MODE + " chromosomes=" + CHROMOSOMES + " (" + N_CHROMOSOMES +
	     ") length=" + GENOME_LENGTH + "bp within_r=" + within_r);
	
	// ----------------------------------------
	// epi states (Ross-Macdonald transmission) 
	// ----------------------------------------
	defineConstant("SUSCEPTIBLE", 0);
	defineConstant("INFECTED", 1);
	
	// Logging
	defineGlobal("TICK_EVENT_ID", 0);
	defineGlobal("INOCULATION_ID", 0);
	// identity counters: one meiosis = one oocyst (tetrad); one uptake/
	// blood-meal mating pool = one brood (>=1 oocyst; co-hatching). lineage_id
	// = genetic identity (a SLiM pedigreeID, propagated through clonal events).
	defineGlobal("NEXT_OOCYST_ID", 0);
	defineGlobal("NEXT_BROOD_ID", 0);
	// D17: import seeding. NEXT_SCRATCH_SUBPOP is a monotonic id for the disposable
	// subpopulation each import-tick mints its genomes in - SLiM refuses to reuse a
	// subpopulation id, so this only ever counts up. It starts just above the host and mosquito
	// range so the two can never collide, but NOT far above: SLiM materialises a DENSE
	// population table up to the highest id used, so a base of 1e6 would add ~1,000,000 empty rows
	// and ~8 MB of padding to every tree sequence from a run with imports.
	defineGlobal("NEXT_SCRATCH_SUBPOP", asInteger(N_HOSTS + N_MOSQ) + 1000);
	// the second compartment of an import, awaiting its clone on the next tick
	defineGlobal("PENDING_BATCH_PED",  integer(0));
	defineGlobal("PENDING_BATCH_N",    integer(0));
	defineGlobal("PENDING_BATCH_INOC", integer(0));
	// Recrudescence: pedigreeIDs of subpatent holders whose replacement genome was minted in
	// THIS tick's reproduction(). killIndividuals() is not legal there, so the retirement is
	// deferred to the top of early(), which runs in the same tick - no lag, and no purge is
	// needed because the list never outlives the tick that filled it. Stores IDs, not
	// Individual references: touching a killed reference is a hard error.
	defineGlobal("RECRUD_RETIRE", integer(0));
	// liveness: has a parasite existed at any point? See the guard at the end of early().
	// A run that never started ends no earlier than LIVENESS_TICK, unless its last day comes
	// first: a margin of a few days after a first-day import pulse (D43).
	defineGlobal("EVER_LIVE", F);
	defineConstant("LIVENESS_TICK", 10);
}

reproduction()
{
	humans = sim.subpopulations[HUMANS];
	mosq = sim.subpopulations[VECTORS];
	// the lineages of the blood-stage clones each host gains today, which h.individuals shows only
	// once reproduction() is over; the MAX_MOI check counts them (D51)
	humans.setValue("new_lineages", integer(0));
	
	// VERBOSE narration: the day's infected and susceptible hosts and mosquitoes
	vcat("⏱️----------" + " tick " + sim.cycle + " ------------⏱️");
	vcat("DEBUG states (start of reproduction callback) on tick " + sim.cycle);
	vcat("Infected 👤: " + sum(humans.tag == INFECTED) + ", susceptible 👤: " + sum(humans.tag == SUSCEPTIBLE));
	vcat("Infected 🦟: " + sum(mosq.tag == INFECTED) + ", susceptible 🦟: " + sum(mosq.tag == SUSCEPTIBLE));
	vcat("---------------------------------------------");
	
	// ----------------------------
	// HYPNOZOITE ACTIVATION (relapse) - DECIDE + SEED (combined)
	// ----------------------------
	// A batch fully exhausted after this tick's thinning is RETIRED by setting
	// batch_count = 0; the "HYPNOZOITE CLEANUP" pass at the top of early() kills every
	// dormant batch with batch_count == 0. It runs immediately after this callback in the
	// SAME tick, so there is no additional lag.
	// ----------------------------
	
	// Resurgence trigger boost on activation rate (relapse-driven) -
	// computed once per tick, not per-batch, since it only depends on
	// sim.cycle.
	effective_alpha_activate = (sim.cycle >= RESURGENCE_TRIGGER_TICK) ?
		ALPHA_ACTIVATE * ALPHA_ACTIVATE_BOOST else ALPHA_ACTIVATE;
	// Keep the competing-risks probabilities valid under a large activation boost -
	// need alpha < 1 and death-thinning MU/(1-alpha) <= 1, i.e. alpha <= 1 - MU.
	effective_alpha_activate = min(asFloat(effective_alpha_activate), 1.0 - MU_HYPNOZOITE);
	
	for (h in humans)
	{
		if (h.individualCount == 0)
			next;
		
		dormant_inds = h.individuals[h.individuals.getValue("is_dormant") == T];
		
		if (size(dormant_inds) == 0)
			next;

		for (hyp in dormant_inds)
		{
			// Skip anything inoculated this same tick
			if (hyp.getValue("inoculation_tick") >= sim.cycle)
				next;
			
			batch_count   = hyp.getValue("batch_count");
			// Emptied by radical cure or MDA after last tick's cleanup ran: nothing is left to
			// progress, activate or die, and the next cleanup in early() removes it.
			if (batch_count == 0)
				next;
			latency_stage = hyp.getValue("latency_stage"); // 0=non-latent, 1-K = latent
			
			// Latency (K_LATENCY > 0, temperate strains, D35). Latent hypnozoites die at
			// MU_HYPNOZOITE, as in White et al. (2014); then the batch moves to the next stage with
			// probability DELTA_LATENCY. The whole batch moves together, as White et al. also track
			// latency per infection.
			if (latency_stage > 0)
			{
				n_dying = rbinom(1, batch_count, asFloat(MU_HYPNOZOITE));
				if (n_dying > 0)
				{
					logEvent("hypnozoite_clearance",
						-1, // no inoc ID bc not V-H event
						-1, h.id,
						asString(hyp.getValue("lineage_id")), "NA", "NA", 0, 0.0, "human", 1,
						asInteger(hyp.getValue("is_imported")),   // the batch's own origin, not a hard-coded 0
						hyp.pedigreeID,
						-1, -1,
						n_dying
						);
					vcat("💀 " + n_dying + " latent hypnozoite(s) died in 👤 human " + h.id + " (brood " + hyp.getValue("lineage_id") + ")");
					batch_count = batch_count - n_dying;
					hyp.setValue("batch_count", batch_count);   // 0 retires it; killed by the early() HYPNOZOITE CLEANUP
				}
				if (batch_count > 0 & runif(1) < DELTA_LATENCY)
				{
					hyp.setValue("latency_stage", latency_stage - 1);
					vcat("💤 Hypnozoite batch (brood " + hyp.getValue("lineage_id") + ") progressed to latency stage " + (latency_stage - 1));
				}
				next;  // cannot activate while still latent
			}
			
			// ----------------------------
			// Non-latent: thin the batch between activation and death.
			// Sequential-binomial decomposition of the per-member
			// multinomial (activate w.p. ALPHA_ACTIVATE, die w.p.
			// MU_HYPNOZOITE, survive otherwise).
			// ----------------------------
			n_activating = rbinom(1, batch_count, effective_alpha_activate);
			remaining    = batch_count - n_activating;
			
			// min(): when alpha = 1 - MU exactly (the clamp above binds, or alpha + MU = 1),
			// MU / (1 - alpha) can round to just above 1 in floating point.
			if (remaining > 0)
				n_dying = rbinom(1, remaining, min(1.0, MU_HYPNOZOITE / (1 - effective_alpha_activate)));
			else
				n_dying = 0;
			
			n_surviving = remaining - n_dying;
			
			// ---- Activation: the n_activating clonal hypnozoites leaving dormancy this
			// tick merge into ONE blood-stage relapse EPISODE, with one detection draw and at
			// most one course. Batch depletion by n_activating is handled above.
			if (n_activating > 0)
			{
				{
					// Is a patent clone of the same lineage already in the host? Such a relapse is
					// counted, and drawn for detection, like any other, but a real observer would see
					// only the infection already there, not a recurrence, so the row says so (D40).
					// Only clones born on earlier days are seen (one that ends today still counts): a
					// clone born this tick, from another batch of the lineage waking, a recrudescence
					// or a bite, is not visible yet, so a relapse that starts with it is not flagged.
					blood = h.individuals[h.individuals.getValue("is_dormant") == F];
					into_patent = 0;
					if (size(blood) > 0)
						into_patent = asInteger(any((blood.getValue("is_subpatent") == F) &
							(blood.getValue("lineage_id") == hyp.getValue("lineage_id"))));
					// A relapse is a clone of the hypnozoite that woke, so it inherits
					// its originating infection's ancestry and is IBD 1 to it. This
					// invariant is asserted in inst/validation/audit_events_and_ibd.R.
					new_active = h.addCloned(hyp);
					h.setValue("new_lineages", c(h.getValue("new_lineages"), hyp.getValue("lineage_id")));
					setHostClone(new_active, hyp, activation=sim.cycle, batch=0, color="darkorange");
					h.tag = INFECTED;

					// detection layer: relapses are mostly sub-patent -> lower detection
					rel_detected = asInteger(runif(1) < P_DETECT_RELAPSE);

					logEvent("hypnozoite_activation",
						-1, // no inoc ID bc not V-H event
						-1, h.id,
						asString(new_active.getValue("lineage_id")), "NA", "NA", 0, 0.0, "human", 0, asInteger(hyp.getValue("is_imported")),  // is_imported carried from the source hypnozoite -> imported relapses are labelled directly
						new_active.pedigreeID,
						hyp.pedigreeID,  // parent1_pedigree_id links back to the source batch object
						// ONE episode row, but n_hypnozoites = the n_activating clonal hypnozoites
						// it represents (so hypnozoite-activation counts stay correct downstream).
						-1, n_activating, hyp.getValue("oocyst_id"), rel_detected, into_patent
						);

					// A detected relapse is a case like any other: it gets the same course a
					// primary would, blood-stage drugs included. Scheduling rather than acting
					// here also keeps this host's batch bookkeeping below untouched.
					if (rel_detected == 1)
						decideTreatment(h);
					
					vcat("🚨Hypnozoite ACTIVATED in 👤 human " + h.id +
						" — brood " + new_active.getValue("lineage_id") +
						" (from batch " + hyp.pedigreeID + "; " + n_activating + " activating this tick, born tick " + hyp.getValue("brood_birth_tick") + ")");
				}
			}
			
			// ---- Deaths within the batch: no individual spawned, just logged as a count ----
			if (n_dying > 0)
			{
				logEvent("hypnozoite_clearance",
					-1, // no inoc ID bc not V-H event
					-1, h.id,
					asString(hyp.getValue("lineage_id")), "NA", "NA", 0, 0.0, "human", 1,
					asInteger(hyp.getValue("is_imported")),   // the batch's own origin, not a hard-coded 0
					hyp.pedigreeID,
					-1, -1,
					n_dying
					);
				
				vcat("💀 " + n_dying + " hypnozoite(s) died without activating in 👤 human " + h.id + " (brood " + hyp.getValue("lineage_id") + ")");
			}
			
			// ---- Update or retire the batch: an empty one is retired (batch_count 0) for
			// the HYPNOZOITE CLEANUP at the top of early(), later this same tick.
			// ----------------------------------------------------------------
			if (n_surviving > 0)
			{
				hyp.setValue("batch_count", n_surviving);
			}
			else
			{
				hyp.setValue("batch_count", 0); // retire; killed by the early() HYPNOZOITE CLEANUP
			}
		}
	}
	
	// ----------------------------
	// D17: SECOND COMPARTMENT OF AN IMPORT (deferred by one tick)
	// ----------------------------
	// Imports themselves are seeded by seedImports() in early() - see the comment on that
	// function for why. What is left here is the half that CANNOT be done there: cloning
	// the hypnozoite batch from the blood-stage genome, so that one inoculation is one
	// genome in two compartments (IBD 1) rather than two unrelated roots. addCloned()
	// is reproduction()-only AND refuses a genome minted in the same tick, so the clone
	// waits until the tick after the import landed, which is now.
	// ----------------------------
	if (size(PENDING_BATCH_PED) > 0)
	{
		// Purge entries whose primary died before we got here (host clearance, treatment).
		// Without this the queue grows without bound.
		alive_peds = sim.subpopulations.individuals.pedigreeID;
		keep = (match(PENDING_BATCH_PED, alive_peds) >= 0);
		if (!all(keep))
		{
			vcat("✈️ Dropping " + sum(!keep) + " queued import batch(es): primary already gone");
			defineGlobal("PENDING_BATCH_PED",  PENDING_BATCH_PED[keep]);
			defineGlobal("PENDING_BATCH_N",    PENDING_BATCH_N[keep]);
			defineGlobal("PENDING_BATCH_INOC", PENDING_BATCH_INOC[keep]);
		}
	}
	for (h in humans)
	{
		if (size(PENDING_BATCH_PED) == 0)
			break;
		if (h.individualCount == 0)
			next;
		for (prim in h.individuals)
		{
			idx = match(prim.pedigreeID, PENDING_BATCH_PED);
			if (idx < 0)
				next;
			n_hyp = PENDING_BATCH_N[idx];
			new_batch = h.addCloned(prim);          // IBD 1 to the primary, by construction
			// the import's origin (no meiosis we simulated, its inoculation, imported); the PRIMARY
			// is the founder, not this copy
			setHostClone(new_batch, prim, activation=NULL, batch=n_hyp, color="turquoise4");
			logEvent("vh_inoculation_import", PENDING_BATCH_INOC[idx], -1, h.id,
				asString(prim.getValue("lineage_id")), "NA", "NA", 0, 0.0, "human",
				1, 1, new_batch.pedigreeID,
				-1,                                 // see seedImports(): logged parent stays -1
				-1, n_hyp, -1);
			sel = (seqAlong(PENDING_BATCH_PED) != idx);
			defineGlobal("PENDING_BATCH_PED",  PENDING_BATCH_PED[sel]);
			defineGlobal("PENDING_BATCH_N",    PENDING_BATCH_N[sel]);
			defineGlobal("PENDING_BATCH_INOC", PENDING_BATCH_INOC[sel]);
		}
	}

	for (m in mosq)
	{
		// Apply intervention biting rate reduction if within intervention
		// window, then apply the resurgence trigger boost if past it -
		// the two are independent and compose multiplicatively.
		effective_biting_rate = BITING_RATE;

		// seasonal forcing (annual sinusoid on biting/vectorial capacity)
		if (SEASONAL_AMP > 0)
		{
			seasonal_mult = 1 + SEASONAL_AMP * cos(6.283185307179586 * (sim.cycle - SEASONAL_PHASE) / 365.0);
			if (seasonal_mult < 0) seasonal_mult = 0;
			effective_biting_rate = effective_biting_rate * seasonal_mult;
		}

		// control programme: suppress biting during the intervention window
		if (sim.cycle >= INTERVENTION_START & sim.cycle < INTERVENTION_END)
			effective_biting_rate = effective_biting_rate * (1 - INTERVENTION_EFFICACY);
		
		if (sim.cycle >= RESURGENCE_TRIGGER_TICK)
			effective_biting_rate = effective_biting_rate * BITING_RATE_BOOST;
		
		// does this mosquito bite today?
		if (runif(1) >= effective_biting_rate)
			next;
		
		
		// find a human to bite
		h = sample(humans, 1);
		
		// what MOI does that human have?
		// INFECTIOUSNESS, not patency: a host carrying only subpatent clones can still infect a
		// mosquito, and counting patent clones here would block exactly the transmission
		// SUBPATENT_INFECTIVITY permits (D25 item 7).
		human_MOI = getTransmissibleLineageCount(h);
		
		// is the mosquito infectious?
		mosq_MOI = getActiveLineageCount(m);
		transmissible_mosq_broods = sampleTransmissibleMosqBroods(m);
		// An INFECTIOUS bite: the mosquito carries a product past the EIP, whatever the bite then
		// does. Counted for the EIR (state.tsv's infectious_bites); sampleTransmissibleMosqBroods()
		// returns nothing exactly when no product has completed the EIP, so this draws no number.
		if (size(transmissible_mosq_broods) > 0)
			h.setValue("inf_bites", h.getValue("inf_bites") + 1);
		
		vcat("---Event info---");
		// --------------------------------------------------
		// Event 1: S mosquito + S human -> nothing
		// --------------------------------------------------
		if (m.tag == SUSCEPTIBLE & h.tag == SUSCEPTIBLE)
		{
			vcat("Sv-Sh event: no transmission");
		}
		
		// --------------------------------------------------
		// Event 2: S mosquito + I human -> mosquito may acquire
		// --------------------------------------------------
		else if (m.tag == SUSCEPTIBLE & h.tag == INFECTED)
		{
			if (human_MOI == 0)
			{
				vcat("note: Sv-Ih: human 👤" + h.id + " tagged infected I but MOI=0; skipping)");
			}
			else if (runif(1) < P_TRANS_HV)
			{
				if (mosq_MOI >= MAX_BROODS_PER_MOSQ)
				{
					vcat("Sv-Ih event: mosquito " + m.id + " at brood cap; no uptake from human " + h.id);
				}
				else
				{
					new_brood_id = seedBroodFromHuman(m, h, m.id, h.id);
					if (size(new_brood_id) > 0)
					{
						m.tag = INFECTED; // mosquito is now infected
						vcat("Sv-Ih event: 🦟 " + m.id + " acquired brood " + paste(new_brood_id, sep="|") + " from 👤 " + h.id +
							" (transmissible at tick " + (sim.cycle + EIP_DAYS) + ")");
					}
					else
					{
						vcat("Sv-Ih event: 🦟 " + m.id + " bit 👤 " + h.id + " but no mature gametocytes; no uptake");
					}
				}
			}
			else
			{
				vcat("Sv-Ih event: bite failed to infect mosquito");
			}
		}
		
		// --------------------------------------------------
		// Event 3: I mosquito + S human -> human may acquire
		// --------------------------------------------------
		else if (m.tag == INFECTED & h.tag == SUSCEPTIBLE)
		{
			if (mosq_MOI == 0)
			{
				vcat("note: Iv-Sh: 🦟 mosquito " + m.id + " tagged infected but has no broods; skipping");
			}
			// The same capacity check as Event 4, before the P_TRANS_VH draw (D38). A host tagged
			// susceptible can still carry blood-stage clones: at SUBPATENT_INFECTIVITY = 0 its
			// subpatent clones are not infectious, but they count toward MAX_MOI.
			else if (getCapacityLineageCount(h) >= MAX_MOI)
			{
				vcat("Iv-Sh event: human 👤" + h.id + " at max MOI (" + MAX_MOI + "); mosquito-to-human transmission skipped");
			}
			else if (size(transmissible_mosq_broods) == 0)
			{
				vcat("Iv-Sh event: 🦟 mosquito " + m.id + " infected but not yet infectious (no brood completed EIP)");
			}
			else if (runif(1) < P_TRANS_VH)
			{
				
				plasmo_mosq = transmissible_mosq_broods; // one Individual per DISTINCT lineage drawn by sampleTransmissibleMosqBroods()
				
				defineGlobal("INOCULATION_ID", INOCULATION_ID + 1); // defineGlobal(): a plain assignment here would be local to the callback
				
				new_lineage_ids = inoculateMosquitoToHuman(plasmo_mosq, h, m.id, INOCULATION_ID);
				
				vcat("Iv-Sh event: 👤 human " + h.id + " acquired brood ( plasmo " + paste(new_lineage_ids, sep="|") + " ) from 🦟" + m.id);
			}
			else
			{
				vcat("Iv-Sh event: infectious bite failed to infect human");
			}
		}
		
		// --------------------------------------------------
		// Event 4: I mosquito + I human -> transmission depends on MOI
		// --------------------------------------------------
		else if (m.tag == INFECTED & h.tag == INFECTED)
		{
			// A host tagged infected may show no transmissible clone yet: one it gained earlier in
			// today's reproduction() is not in h.individuals until that is over. It can still be
			// infected; it cannot yet infect the mosquito (D51).
			if (mosq_MOI == 0)
			{
				vcat("note: Iv-Ih: mosquito tagged I but has no broods; skipping");
			}
			else
			{
				// ------------------------------------------
				// 👤 HUMAN 👤
				// ------------------------------------------
				if (getCapacityLineageCount(h) < MAX_MOI)   // capacity: patent, subpatent and today's
				{
					if (size(transmissible_mosq_broods) == 0)
					{
						vcat("Iv-Ih event: 🦟 mosquito " + m.id + " infected but not yet infectious; no superinfection of 👤 human " + h.id);
					}
					else if (runif(1) < P_TRANS_VH)
					{
						plasmo_mosq = transmissible_mosq_broods; // one Individual per DISTINCT lineage drawn by sampleTransmissibleMosqBroods()
						
						defineGlobal("INOCULATION_ID", INOCULATION_ID + 1); // defineGlobal(): a plain assignment here would be local to the callback
						
						new_lineage_ids = inoculateMosquitoToHuman(plasmo_mosq, h, m.id, INOCULATION_ID);
						
						vcat("Iv-Ih event 🔂: 👤 human " + h.id +
							" was superinfected by infectious 🦟 mosquito " + m.id + " with new broods plasmo " + paste(new_lineage_ids, sep="|") + " (in addition to plasmo " + h.individuals.pedigreeID + " )");
					}
				}
				else
				{
					vcat("Iv-Ih event: human 👤" + h.id + " at max MOI (" + MAX_MOI + "); mosquito-to-human transmission skipped");
				}
				
				// ------------------------------------------
				// 🦟 MOSQUITO 🦟
				// ------------------------------------------
				takes_up = F;
				if (human_MOI > 0)
					takes_up = (runif(1) < P_TRANS_HV);
				if (takes_up)
				{
					if (getActiveLineageCount(m) >= MAX_BROODS_PER_MOSQ)
					{
						vcat("Iv-Ih event: mosquito " + m.id + " at brood cap; uptake skipped");
					}
					else
					{
						new_brood_id = seedBroodFromHuman(m, h, m.id, h.id);
						vcat("Iv-Ih event: 🦟 mosquito " + m.id + " picked up new brood ( " + paste(new_brood_id, sep="|") + " ) from 👤 human " + h.id);
					}
				}
				else
				{
					vcat("Iv-Ih event: infected pair bite, no successful uptake");
				}
			}
		}
		
		// --------------------------------------------------
		// Fallback safety branch
		// --------------------------------------------------
		else
		{
			catn("WARNING: reached unexpected state for 🦟 mosquito " + m.id + " and human " + h.id +
				" (m.tag=" + m.tag + ", h.tag=" + h.tag +
				", m.count=" + m.individualCount + ", h.count=" + h.individualCount + ")");
		}
	}

	// ----------------------------
	// RECRUDESCENCE: a suppressed clone re-expands to patency
	// ----------------------------
	// Mints a NEW genome clonal to the holder, exactly as a relapse does (D25): a fresh
	// pedigree_id keeps one episode to one id, gives the recurrence its own ARG node dated at
	// the recurrence rather than at the original inoculation, and keeps "IBD to the prior
	// episode == 1" a real measurement instead of a self-pair. The holder is then queued for
	// retirement in early(), which makes the pair exactly MOI-neutral - the minted genome
	// inherits lineage_id, and getActiveLineageCount() dedupes on it.
	// ----------------------------
	for (h in humans)
	{
		if (h.individualCount == 0)
			next;
		holders = h.individuals[h.individuals.getValue("is_dormant") == F &
		                        h.individuals.getValue("is_subpatent") == T];
		for (hold in holders)
		{
			rt = hold.getValue("recrud_tick");
			if (isNULL(rt))
				next;
			if (rt > sim.cycle)
				next;
			new_active = h.addCloned(hold);
			h.setValue("new_lineages", c(h.getValue("new_lineages"), hold.getValue("lineage_id")));
			setHostClone(new_active, hold, activation=sim.cycle, batch=0, color="red");
			h.tag = INFECTED;
			rec_detected = asInteger(runif(1) < P_DETECT_RECRUD);
			// inoculation_id is logged as -1, as a relapse's is, and so is oocyst_id, unlike a
			// relapse, which logs its batch's: a recrudescence is not a V-H event, and inheriting
			// them would put it inside another case's co-transmission group. The link back to the
			// holder (and so to the originating bite) is carried exactly by parent1_pedigree_id.
			logEvent("recrudescence", -1, -1, h.id,
				asString(new_active.getValue("lineage_id")), "NA", "NA", 0, 0.0, "human",
				0, asInteger(hold.getValue("is_imported")), new_active.pedigreeID,
				hold.pedigreeID, -1, 1, -1, rec_detected);
			defineGlobal("RECRUD_RETIRE", c(RECRUD_RETIRE, hold.pedigreeID));
			if (rec_detected == 1)
				decideTreatment(h);
		}
	}

	self.active = 0;
}

// One-shot clonal founder seeding. addCloned() is only legal inside reproduction(), and at tick 1
// reproduction() never fires (no individuals exist until 1 early() seeds them), so the clonal founder
// HOSTS recorded during setup are copied here at tick 2 - the first tick individuals exist. Runs once,
// then self-deactivates. Default N_FOUNDER_LINEAGES == N_FOUNDER_HOSTS => nothing pending => no-op.
// A day-1 import pulse lands before this (D39): a clone host is still empty then, so MAX_MOI does not
// refuse it an import and it holds both from tick 2, and an import can sit beside a template founder.
// Day 2's bites come before this too (SLiM calls reproduction() callbacks in script order), so the
// MAX_MOI check does not refuse a clone host a bite that day either.
2 reproduction()
{
	for (i in seqLen(size(PENDING_CLONE_HOSTS)))
	{
		tsub = sim.subpopulations[sim.subpopulations.id == PENDING_CLONE_HOSTS[i]];     // the empty founder host
		tsp  = sim.subpopulations[sim.subpopulations.id == PENDING_CLONE_TEMPLATES[i]]; // its assigned founder-lineage subpop
		// the template founder genome: the one genome in its host that is not an import. A day-1
		// import can share the host; takeMigrants() appends it, so the founder is also the first.
		tmpl = tsp.individuals[tsp.individuals.getValue("is_imported") == F][0];
		clone = tsub.addCloned(tmpl);            // genetic clone -> IBD 1 to the template lineage in the tree

		// a founder, as in 1 early(), of the template's lineage rather than a new one
		setHostGenome(clone, birth=sim.cycle, lineage=tmpl.getValue("lineage_id"), oocyst=-1, brood=-1,
			founder=T, inoc_tick=sim.cycle, inoc_id=-1, imported=F, activation=NULL, batch=0, color="grey");
		tsub.tag = INFECTED;

		// log a synthetic seed event so founder provenance / transmission chains stay complete
		logEvent(
			"vh_inoculation_seed",
			-1,           // no inoculation id (seeding event)
			-1, tsub.id,
			asString(tmpl.getValue("lineage_id")),
			"NA", "NA",
			0, 0.0,
			"human",
			0, 0,
			clone.pedigreeID
			);
	}
	self.active = 0;   // one-shot: never runs again this tick
}

1 early() {

	// --- provenance: dump resolved run parameters to OUTDIR/params.tsv ---
	_pn = c("SIM_ID","SEED","SIM_DAYS","N_HOSTS","N_FOUNDER_HOSTS","N_FOUNDER_LINEAGES","N_MOSQ","BITING_RATE","P_TRANS_VH","P_TRANS_HV","MOSQ_LIFESPAN","EIP_DAYS","MAX_MOI","MAX_BROODS_PER_MOSQ","MEAN_BLOOD_STAGE_DURATION","LAMBDA_OOCYSTS","LAMBDA_SPOROZOITES","K_OOCYSTS","GAMETOCYTE_DELAY","P_GAMETOCYTE","P_PRIMARY","NU_HYPNOZOITE_BATCH","ALPHA_ACTIVATE","MU_HYPNOZOITE","K_LATENCY","DELTA_LATENCY","INTERVENTION_START","INTERVENTION_END","INTERVENTION_EFFICACY","TREATMENT_START","TREATMENT_END","SEASONAL_AMP","SEASONAL_PHASE","P_DETECT_PRIMARY","P_DETECT_RELAPSE","RADCURE_COVERAGE","RESURGENCE_TRIGGER_TICK","BITING_RATE_BOOST","ALPHA_ACTIVATE_BOOST","NU_HYPNOZOITE_BATCH_BOOST","MDA_TICK","MDA_COVERAGE","P_RECRUD_GIVEN_FAIL","MEAN_RECRUD_DELAY","RECRUD_DELAY_DIST","P_DETECT_RECRUD","SUBPATENT_INFECTIVITY","P_RAD_SURVIVAL","RADCURE_MODE","BLOODCURE_COVERAGE","P_BLOODCURE_SURVIVAL","TREATMENT_DELAY","IMPORT_START","IMPORT_END","N_IMPORTS_PER_TICK","IMPORT_RATE_PER_TICK","IMPORT_RATE_BOOST","IMPORT_TICK","N_IMPORTS","RETAIN_FULL_HISTORY","GENOME_MODE","CHROMOSOMES","RECOMB_RATE","GENOME_LENGTH","N_CHROMOSOMES","RECOMB_WITHIN","VERBOSE");
	_plines = "param\tvalue";
	_plines = c(_plines, "ACTUAL_SEED\t" + getSeed());
	_plines = c(_plines, "SLIM_VERSION\t" + version(F)[1]);
	_plines = c(_plines, "MALARIAFWD_VERSION\t" + (exists("MALARIAFWD_VERSION") ? MALARIAFWD_VERSION else "unknown"));
	for (_nm in _pn)
		_plines = c(_plines, _nm + "\t" + paramText(executeLambda(_nm + ";")));
	writeFile(OUTDIR + "/params.tsv", _plines);

	n_subpops = asInteger(N_HOSTS + N_MOSQ);

	founder_templates = c();          // distinct founder-lineage template individuals (genome roots)
	pending_clone_hosts     = c();    // subpop IDs of founder HOSTS awaiting a clonal copy (seeded tick 2; addCloned needs reproduction())
	pending_clone_templates = c();    // subpop ID of the founder LINEAGE each pending clone-host copies

	for (s in seqLen(n_subpops))
	{
		// Establishment (N_FOUNDER_HOSTS infected hosts) is set apart from diversity (N_FOUNDER_LINEAGES distinct
		// genomes). First N_FOUNDER_LINEAGES founder hosts = new distinct lineages; the rest = GENETIC CLONES of them
		// (addCloned -> IBD 1 in the tree).
		// A naive population, seeded only by imports, is N_FOUNDER_HOSTS = 0 with an import path (D39).
		if (s < N_HOSTS & s < N_FOUNDER_LINEAGES)    // a NEW distinct founder lineage (genome root), human host
		{
			subpop = sim.addSubpop(s, 1);
			founder_templates = c(founder_templates, subpop.individuals);
		}
		else if (s < N_HOSTS & s < N_FOUNDER_HOSTS)  // founder host carrying a CLONAL COPY (empty now; cloned tick 2)
		{
			subpop = sim.addSubpop(s, 0);            // empty for now; clone added by the one-shot 2 reproduction()
			// record integer IDs only (defineGlobal can't retain Subpopulation objects). Templates = subpops 0..N_FOUNDER_LINEAGES-1.
			pending_clone_hosts     = c(pending_clone_hosts, s);
			pending_clone_templates = c(pending_clone_templates, sample(seqLen(asInteger(N_FOUNDER_LINEAGES)), 1));
		}
		else                                         // a susceptible host, or a mosquito: every mosquito starts uninfected
			subpop = sim.addSubpop(s, 0);

		subpop.tag = (subpop.individualCount == 1) ? INFECTED else SUSCEPTIBLE;
		
		// founders arise from no meiosis and belong to no co-hatching brood; seeded directly in the
		// host, the seed is their 'inoculation'
		for (lin in subpop.individuals)
			setHostGenome(lin, birth=sim.cycle, lineage=lin.pedigreeID, oocyst=-1, brood=-1, founder=T,
				inoc_tick=sim.cycle, inoc_id=-1, imported=F, activation=NULL, batch=0, color="grey");
	}
	
	// A run with founders has had a parasite from tick 1, even if something cleared them all
	// before the liveness check at the end of early() (D43).
	if (N_FOUNDER_HOSTS > 0)
		defineGlobal("EVER_LIVE", T);
	// hand the pending clonal-founder assignments (integer subpop IDs) to the one-shot 2 reproduction() seeder (tick 2)
	defineGlobal("PENDING_CLONE_HOSTS", pending_clone_hosts);
	defineGlobal("PENDING_CLONE_TEMPLATES", pending_clone_templates);

	// add tags for hosts supop and mosq subpops
	defineConstant("HUMANS", seqLen(asInteger(N_HOSTS)));
	defineConstant("VECTORS", seq(asInteger(N_HOSTS), asInteger(N_MOSQ + N_HOSTS) - 1));
	sim.subpopulations[HUMANS].setValue("pop_type", "human");
	// infectious bites each host received today, for the EIR; written and reset by
	// writeStateSnapshot()
	sim.subpopulations[HUMANS].setValue("inf_bites", 0);
	sim.subpopulations[HUMANS].setValue("new_lineages", integer(0));
	sim.subpopulations[VECTORS].setValue("pop_type", "mosquito");
	
	humans = sim.subpopulations[HUMANS];
	mosq = sim.subpopulations[VECTORS];
	
	mosq.setValue("mosq_birth_tick", sim.cycle);
	
	// case-management state: one pending course per host at a time
	for (h in humans)
	{
		h.setValue("tx_pending", F);
		h.setValue("tx_tick", -1);
		h.setValue("tx_liver", F);
	}

	vcat("---- Initial seeding : -----");
	vcat("Infected 👤: " + sum(humans.tag == INFECTED) + ", susceptible 👤: " + sum(humans.tag == SUSCEPTIBLE));
	vcat("Infected 🦟: " + sum(mosq.tag == INFECTED) + ", susceptible 🦟: " + sum(mosq.tag == SUSCEPTIBLE));
	
	// VERBOSE narration: each subpopulation's starting count
	for (subpop in sim.subpopulations)
		vcat("subpop " + subpop.id + " has " + subpop.individualCount + " plasmodiums and tag " + subpop.tag);
	
	// OUTPUT --------------
	writeFile(OUTDIR + "/events.tsv",
		paste(c(
		"tick", "event_id", "event_type", "inoculation_id",
		"mosq_id", "human_id",
		"lineage_id", "parent1_lineage_id", "parent2_lineage_id",
		"is_recombinant", "p_outcross", "recipient", "is_dormant", "is_imported",
		"pedigree_id", "parent1_pedigree_id", "parent2_pedigree_id", "n_hypnozoites",
		"oocyst_id", "detected", "into_patent_lineage"
		), sep="\t"),
		append=F);
	
	writeFile(OUTDIR + "/state.tsv",
		paste(c(
		"tick", "entity_type", "entity_id",
		"tag", "moi_active", "moi_subpatent", "moi_dormant", "hyp_reservoir_size", "lineage_ids",
		"n_transmissible", "mosq_age_days", "infectious_bites"
		), sep="\t"),
		append=F);
	
	// -------------------------------------------------------
	// Log the founders so transmission chains are complete from
	// tick 1: they were never acquired by a bite, so each gets a
	// synthetic vh_inoculation_seed row. Mosquitoes start uninfected.
	// -------------------------------------------------------
	
	// Founder blood-stage clones
	for (h in humans)
	{
		if (h.individualCount > 0)
		{
			for (lin in h.individuals)
			{
				logEvent(
					"vh_inoculation_seed",
					-1, // no inoc ID bc seeding event
					-1, h.id,
					asString(lin.getValue("lineage_id")),
					"NA", "NA",
					0, 0.0,
					"human",
					0, 0,
					lin.pedigreeID
					);
			}
		}
	}
}


early() {
	// subset humans and mosquitoes
	humans = sim.subpopulations[HUMANS];
	mosq = sim.subpopulations[VECTORS];
	
	// ----------------------------
	// HYPNOZOITE CLEANUP
	// ----------------------------
	// kills every dormant batch RETIRED with batch_count == 0 (exhausted by activation or
	// death, or emptied by radical cure / MDA). killIndividuals() isn't legal in
	// reproduction(), so this is deferred here. A batch exhausted in reproduction() is
	// removed later in the same tick; one emptied by treatment or MDA, which run after this
	// cleanup, stays until the next tick's cleanup, and reproduction() skips it meanwhile.
	// ----------------------------
	for (h in humans)
	{
		if (h.individualCount == 0)
			next;
		dormant = h.individuals[h.individuals.getValue("is_dormant") == T];
		if (size(dormant) == 0)
			next;
		retired = dormant[dormant.getValue("batch_count") == 0];
		if (size(retired) > 0)
		{
			// retain cleared/dead infections so IBD to prior infections stays valid
			sim.treeSeqRememberIndividuals(retired, permanent=RETAIN_FULL_HISTORY);
			sim.killIndividuals(retired);
		}
	}
	
	// ----------------------------
	// RECRUDESCENCE RETIREMENT
	// ----------------------------
	// Drained FIRST, before case management and before natural clearance, so a holder whose
	// replacement was minted moments ago in reproduction() cannot also draw a
	// P_BLOODCURE_SURVIVAL roll or a P_BLOOD_CLEAR roll and log a phantom event.
	// ----------------------------
	if (size(RECRUD_RETIRE) > 0)
	{
		for (h in humans)
		{
			if (h.individualCount == 0)
				next;
			gone = h.individuals[match(h.individuals.pedigreeID, RECRUD_RETIRE) >= 0];
			if (size(gone) > 0)
			{
				sim.treeSeqRememberIndividuals(gone, permanent=RETAIN_FULL_HISTORY);
				sim.killIndividuals(gone);
			}
		}
		defineGlobal("RECRUD_RETIRE", integer(0));
	}

	// ----------------------------
	// CASE MANAGEMENT: apply the courses that are due
	// ----------------------------
	// Deliberately AFTER the hypnozoite cleanup and BEFORE natural clearance. Applying here,
	// rather than where the case was detected, is what lets a course reach the hypnozoite batch
	// seeded by the very bite that caused it: juveniles created in reproduction() are invisible
	// until that callback ends, and this is the first point at which they can be seen.
	// ----------------------------
	for (h in humans)
	{
		if (!h.getValue("tx_pending"))
			next;
		if (h.getValue("tx_tick") > sim.cycle)
			next;
		applyTreatment(h, h.getValue("tx_liver"), "case");
		h.setValue("tx_pending", F);
	}

	// ----------------------------
	// Blood-stage clearance (probabilistic)
	// ----------------------------
	
	// HUMANS ----------------------
	for (h in humans)
	{
		if (getActiveLineageCount(h) == 0)
			next;
		
		cleared_natural = c();

		for (lin in h.individuals)
		{
			if (lin.getValue("is_dormant") == T)
				next;  // skip if dormant, hypnozoite clearance is separate
			// Natural clearance while subpatent is OFF by design (D25): every suppressed
			// clone eventually recrudesces unless an MDA round clears it (D44), which is what
			// makes P_RECRUD_GIVEN_FAIL, without MDA, exactly P(recrudescence | the course
			// failed) and directly comparable to a WHO therapeutic-efficacy failure rate.
			if (lin.getValue("is_subpatent") == T)
				next;

			bloodstage_start = lin.getValue("bloodstage_start_tick");

			if (isNULL(bloodstage_start))
			{
				catn("⚠️ WARNING: active individual missing bloodstage_start_tick — brood " +
					lin.getValue("lineage_id") + " in human " + h.id);
				next;
			}

			// A clone cannot clear on the tick its blood stage began
			if (bloodstage_start >= sim.cycle)
				next;

			// Natural clearance: a Bernoulli trial each day, so the duration is geometric (D29, D30)
			if (runif(1) < P_BLOOD_CLEAR)
				cleared_natural = c(cleared_natural, lin);
		}

		if (size(cleared_natural) > 0)
		{
			// retain cleared blood-stage infections (the prior-primary an IBD
			// comparison needs) - permanent=T keeps their ancestry from being simplified away
			sim.treeSeqRememberIndividuals(cleared_natural, permanent=RETAIN_FULL_HISTORY);
			sim.killIndividuals(cleared_natural);

			for (lin in cleared_natural)
				logEvent("human_clearance", -1, -1, h.id,
					asString(lin.getValue("lineage_id")), "NA", "NA", 0, 0.0, "human",
					0, asInteger(lin.getValue("is_imported")), lin.pedigreeID);
		}
	}
	
	
	// MOSQUITOES ----------------------
	for (m in mosq)
	{
		if(runif(1) < MU_MOSQ)
		{
			// capture the individuals BEFORE killing so we can log each
			// one's own pedigreeID
			dying_inds = m.individuals;
			
			// Log one event per killed individual
			if (size(dying_inds) > 0)
			{
				for (lin in dying_inds)
				{
					logEvent(
						"mosq_death",
						-1, // no inoc ID bc not V-H event
						m.id, -1,
						asString(lin.getValue("lineage_id")),
						"NA", "NA",
						0, 0.0,
						"mosquito",
						0, 0,
						lin.pedigreeID
						);
				}
			}
			
			// Kill all individuals and reset mosquito
			if(m.individualCount > 0)
			{
				// retain mosquito-stage broods (internal transmission-chain nodes)
				sim.treeSeqRememberIndividuals(dying_inds, permanent=RETAIN_FULL_HISTORY);
				sim.killIndividuals(dying_inds);
			}
			
			m.tag = SUSCEPTIBLE;
			m.setValue("mosq_birth_tick", sim.cycle);
		}
	}
	
	// -----------------------------
	// Update host and vector states after clearance
	// -----------------------------
	for (h in humans)
		h.tag = (getTransmissibleLineageCount(h) > 0) ? INFECTED else SUSCEPTIBLE;
	
	for (m in mosq)
		m.tag = (m.individualCount > 0) ? INFECTED else SUSCEPTIBLE;
	
	
	// ----------------------------------------
	// Optional MDA event (assume both blood-stage and liver-stage drugs used)
	// ----------------------------------------
	if (sim.cycle == MDA_TICK)
	{
		// MDA is the same course as case management, given to each host it reaches (MDA_COVERAGE)
		// rather than to detected cases: blood-stage drugs plus radical cure, through
		// applyTreatment() so the two paths cannot diverge. Because it waits for no
		// symptoms, it also reaches subpatent clones and clones that became patent earlier today,
		// which a case course does not (D44); the day's imports arrive after it. Only hosts not
		// empty at the round are drawn, so the mda_*_given counts are courses to those hosts; the
		// draw does not depend on infection, so the coverage is that of everyone.
		vcat("💊 MDA administered on tick " + sim.cycle);
		n_reached = 0;
		for (h in humans)
		{
			if (h.individualCount == 0)
				next;
			// Draw ONLY below full coverage. Eidos does not short-circuit, so a bare
			// `runif(1) >= MDA_COVERAGE` would consume a draw per host even at 1.0 and shift
			// the rest of the run's random numbers, although the round still reaches everyone.
			if (MDA_COVERAGE < 1.0)
				if (runif(1) >= MDA_COVERAGE)
					next;
			applyTreatment(h, T, "mda");
			n_reached = n_reached + 1;
		}
		vcat("💊 MDA reached " + n_reached + " host(s)");
	}
	
	// ----------------------------
	// IMPORTATION EVENT(S)
	// ----------------------------
	// Supports:
	//   (A) one importation event: IMPORT_TICK + N_IMPORTS
	//   (B) repeated importation, fixed count: IMPORT_START <= tick < IMPORT_END with N_IMPORTS_PER_TICK
	//   (C) repeated importation, stochastic rate: IMPORT_START <= tick < IMPORT_END with IMPORT_RATE_PER_TICK
	//       (Poisson-distributed arrivals, e.g. IMPORT_RATE_PER_TICK=0.25 -> ~1 import every 4 days on average)
	//
	// Imports go to hosts chosen uniformly at random, as bites do, at most one per host a tick
	// (D38); a host already at MAX_MOI takes none. Each import is logged as
	// "vh_inoculation_import" with inoculation_id.
	// Each import is an independent founder genome, unrelated to every other (D18).
	// ----------------------------
	
	// determine desired imports this tick
	n_import_target = 0;
	
	// single importation event
	if (sim.cycle == IMPORT_TICK & N_IMPORTS > 0)
		n_import_target = N_IMPORTS;
	
	// repeated importation window (can be added on top of a single event or on its own)
	if (sim.cycle >= IMPORT_START & sim.cycle < IMPORT_END & N_IMPORTS_PER_TICK > 0)
		n_import_target = n_import_target + N_IMPORTS_PER_TICK;
	
	// stochastic arrival-rate version of the above - draws the actual
	// count this tick from Poisson(IMPORT_RATE_PER_TICK), so most ticks
	// will see 0 imports and only occasionally 1 (or rarely more), rather
	// than a guaranteed fixed count every single tick.
	if (sim.cycle >= IMPORT_START & sim.cycle < IMPORT_END & IMPORT_RATE_PER_TICK > 0)
	{
		eff_import_rate = IMPORT_RATE_PER_TICK;
		// seasonal importation (cross-border movement peaks in the transmission season)
		if (SEASONAL_AMP > 0)
		{
			imp_seasonal = 1 + SEASONAL_AMP * cos(6.283185307179586 * (sim.cycle - SEASONAL_PHASE) / 365.0);
			if (imp_seasonal < 0) imp_seasonal = 0;
			eff_import_rate = eff_import_rate * imp_seasonal;
		}
		// Local vector control (INTERVENTION_*) does not scale imports: they are infections
		// acquired elsewhere (D46). A border measure is IMPORT_RATE_BOOST, or the window itself.
		// import-driven resurgence: leaky border reopens after the trigger
		if (sim.cycle >= RESURGENCE_TRIGGER_TICK)
			eff_import_rate = eff_import_rate * IMPORT_RATE_BOOST;
		// rpois() refuses a rate of 0, which a closed border (IMPORT_RATE_BOOST = 0) or a seasonal
		// amplitude above 1 produces
		if (eff_import_rate > 0.0)
			n_import_target = n_import_target + rpois(1, eff_import_rate);
	}
	
	if (n_import_target > 0)
	{
		// Uniformly random hosts, at most one import per host a tick, so a tick's imports beyond
		// N_HOSTS are dropped (this keeps the R cap of 1e6 imports a day cheap to run). A host
		// already carrying MAX_MOI blood-stage lineages takes none, as for a local bite; the
		// refusal is logged as vh_inoculation_import_no_take.
		import_hosts = sample(humans, min(asInteger(n_import_target), size(humans)));
		full = (sapply(import_hosts, "getBloodStageLineageCount(applyValue);") >= MAX_MOI);
		for (h_full in import_hosts[full])
		{
			defineGlobal("INOCULATION_ID", INOCULATION_ID + 1);
			logEvent("vh_inoculation_import_no_take", INOCULATION_ID, -1, h_full.id,
				"NA", "NA", "NA", 0, 0.0, "human", -1, 1);
		}
		import_hosts = import_hosts[!full];

		// Seeded HERE, in early(): SLiM calls reproduction() only while a parasite exists, so
		// seeding there could never reach an empty population (D17).
		if (size(import_hosts) > 0)
			seedImports(import_hosts);
	}

	// ---- LIVENESS ------------------------------------------------------------------------
	// Placed last in early(), after seeding and importation, so it sees the tick's final state.
	// Two different situations, deliberately treated differently:
	//
	//   NEVER STARTED  - no parasite has existed at any point, and none can still come: the run is
	//                    past its last import day and at LIVENESS_TICK or later, or on its last
	//                    day. Only a founder-free run can get here: validate_params() and the
	//                    initialize() fence refuse one with no import path inside it, so its
	//                    imports were all there but none established a parasite, by chance (a
	//                    Poisson rate that drew none, imports that took in neither compartment)
	//                    or because its settings let none take (P_PRIMARY = 0 with a hypnozoite
	//                    batch mean of 0, a window whose rate is 0 throughout). That is a result,
	//                    as fade-out is, so the run ends cleanly, on its own record (D43). Unlike
	//                    extinction it is also decided on the last day whatever the import
	//                    schedule, so that every run that never had a parasite is marked.
	//   DIED OUT       - parasites existed and are now all gone, with no importation still to
	//                    come. Fade-out and elimination are legitimate RESULTS, not errors, so
	//                    this is not fatal: the run ends cleanly here because every remaining
	//                    tick is provably empty, and says so in the log.
	// Every subpopulation counts, so a parasite still in a mosquito keeps the run going.
	n_alive = sum(sim.subpopulations.individualCount);
	if (n_alive > 0)
		defineGlobal("EVER_LIVE", T);
	else
	{
		// Both branches require that no importation is still to come, except that a run that
		// never started is also marked on its last day. Without that, a run with a LATE import
		// window (say IMPORT_START = 500 of 1000 days) would be killed during the empty ticks
		// before the window opens - which is a legitimate configuration, not a failure. An import
		// is still to come until the run passes LAST_IMPORT_DAY; one set for a day outside the run
		// never comes. A window inside the run counts to its last day even while its rate is 0 (a
		// closed border).
		import_still_possible = (sim.cycle <= LAST_IMPORT_DAY);
		if (!EVER_LIVE & (sim.cycle == SIM_DAYS | (sim.cycle >= LIVENESS_TICK & !import_still_possible)))
		{
			catn("🛑 NEVER STARTED on tick " + sim.cycle + ": no import established a parasite, and " +
				"none is still to come. Ending the run - every further tick is empty.");
			sim.treeSeqOutput(OUTDIR + "/plasmo.trees");
			// recorded so that R can tell a run that never started from one that went extinct (D43)
			writeFile(OUTDIR + "/params.tsv", "NEVER_STARTED\t" + sim.cycle, append=T);
			catn("-----------⌛️ SIMULATION FINISHED! ⌛️-----------");
			sim.simulationFinished();
		}
		if (EVER_LIVE & !import_still_possible)
		{
			catn("🛑 EXTINCT on tick " + sim.cycle + ": no parasite in any host or mosquito, no " +
				"hypnozoite, and no importation still to come. Ending the run - every further tick is empty.");
			// The TREE SEQUENCE is written here because the `SIM_DAYS late()` event writes it
			// only on the last day; on that day it writes it again, and prints the banner again.
			// The state snapshot is left to late(), which still runs because simulationFinished()
			// lets the current tick finish; writing it here as well would give this tick's rows
			// twice.
			sim.treeSeqOutput(OUTDIR + "/plasmo.trees");
			// recorded so that R can tell a run that went extinct from one that did not (D37), also
			// when this is the last day
			writeFile(OUTDIR + "/params.tsv", "EXTINCT_TICK\t" + sim.cycle, append=T);
			catn("-----------⌛️ SIMULATION FINISHED! ⌛️-----------");
			sim.simulationFinished();
		}
	}
}

1:(asInteger(SIM_DAYS) - 1) late()
{
	writeStateSnapshot();
}

asInteger(SIM_DAYS) late() {
	writeStateSnapshot();
	sim.treeSeqOutput(OUTDIR + "/plasmo.trees");
	vcat("------------------------------------------------");
	catn("-----------⌛️ SIMULATION FINISHED! ⌛️-----------");
	vcat("------------------------------------------------");

}


///
// -------------------------
// FUNCTIONS
// -------------------------
// A parameter as params.tsv records it. A float is written to 15 significant digits, the
// precision run_sim() passes to SLiM, so that R reads the record back as the value the run used. A
// float that prints as a plain whole number keeps a decimal point ("7.0"), as SLiM writes floats;
// an exponent form ("7.4e-07", "1e+15") is kept as printf writes it, since R reads "1.0e-25" and
// "1e-25" differently. Every float parameter is finite (initialize() refuses the others).
function (string$) paramText(* v)
{
	if (!isFloat(v))
		return paste(v, sep=",");
	s = format("%.15g", v);
	if (strfind(s, ".") >= 0 | strfind(s, "e") >= 0)
		return s;
	return s + ".0";
}

// A parameter's value for a message: a float to 15 significant digits, so that 1.0000001 does
// not print as 1.0, and a string quoted.
function (string$) shown(* v)
{
	if (isFloat(v))
		return format("%.15g", v);
	if (isString(v))
		return "'" + v + "'";
	return asString(v);
}

function (void) defineDefault(s$ name, * value)
{
	if (!exists(name))
		defineConstant(name, value);
	// a parameter given with -d already exists, and keeps its value
}

// vcat: verbose cat. Prints only when VERBOSE is TRUE; used for all per-event / per-tick
// narration so a run can be silenced (VERBOSE=F, default) without touching results or data
// files. GENOME / WARNING / SIMULATION FINISHED prints deliberately use catn() (always shown).
function (void) vcat([* msg = ""])
{
	if (VERBOSE)
		catn(msg);
}

function (void) logEvent(
	s$ event_type,
	i$ inoculation_id,
	i$ mosq_id,
	i$ human_id,
	s$ lineage_id,                     // genetic identity; parent1/2_lineage_id are the PARENT lineages
	s$ parent1_lineage_id,
	s$ parent2_lineage_id,
	i$ is_recombinant,
	f$ p_outcross,
	s$ recipient,
	i$ is_dormant,
	i$ is_imported,
	[i$ pedigree_id = -1],             // pedigreeID of the specific Individual central to this event
	[i$ parent1_pedigree_id = -1],     // pedigreeID of parent1 Individual (recombination/clonal source), -1 if NA
	[i$ parent2_pedigree_id = -1],     // pedigreeID of parent2 Individual (recombination source only), -1 if NA
	[i$ n_hypnozoites = 1],            // count represented by this event; 1 for non-batch events, actual batch/thinning count for hypnozoite batch establishment/activation/death/MDA events
	[i$ oocyst_id = -1],               // meiosis id shared by a tetrad's products; -1 for founders/imports (no meiosis)
	[i$ detected = -1],                // detection layer: 1 = detected/reported case, 0 = true-but-undetected episode, -1 = N/A (non-case event)
	[i$ into_patent_lineage = -1])     // on hypnozoite_activation rows: 1 if a patent clone of the same lineage, born on an earlier day, was in the host (D40), 0 if not; -1 elsewhere
{
	defineGlobal("TICK_EVENT_ID", TICK_EVENT_ID + 1); // defineGlobal(): a plain assignment here would be local to the function
	event_id = asString(sim.cycle) + "_" + asString(TICK_EVENT_ID);

	line = paste(c(
		asString(sim.cycle),
		event_id,
		event_type,
		asString(inoculation_id),
		asString(mosq_id),
		asString(human_id),
		lineage_id,
		parent1_lineage_id,
		parent2_lineage_id,
		asString(is_recombinant),
		asString(p_outcross),
		recipient,
		asString(is_dormant),
		asString(is_imported),
		asString(pedigree_id),
		asString(parent1_pedigree_id),
		asString(parent2_pedigree_id),
		asString(n_hypnozoites),
		asString(oocyst_id),
		asString(detected),
		asString(into_patent_lineage)
		), sep="\t");

	writeFile(OUTDIR + "/events.tsv", line, append=T);
}

function (void) writeStateSnapshot(void)
{
	humans = sim.subpopulations[HUMANS];
	mosq   = sim.subpopulations[VECTORS];
	
	// Rows are collected and appended in one call at the end: opening and closing the file
	// once per row cost most of a run's time.
	rows = rep("", size(humans) + size(mosq));
	k = 0;
	
	for (h in humans)
	{
		// Count only lineages that are actually PRESENT: a dormant batch retired to
		// batch_count == 0 lives until the next tick's cleanup, and listing it here would make
		// state.tsv contradict itself - rows reporting moi_active 0, moi_dormant 0 and
		// hyp_reservoir_size 0 while still naming a lineage. That happens on exactly the tick
		// a liver drug clears a reservoir, which is the tick its efficacy is measured on.
		// getDormantLineageCount() applies the same filter.
		// Per-individual loop, not a vectorised getValue(): batch_count is NULL on an ACTIVE
		// individual, so reading it across the whole subpopulation returns a shorter vector
		// than it was indexed with.
		shown = c();
		for (ind in h.individuals)
		{
			if (ind.getValue("is_dormant") == T)
			{
				bc = ind.getValue("batch_count");
				if (isNULL(bc) | (bc <= 0))
					next;
			}
			shown = c(shown, ind.getValue("lineage_id"));
		}
		lineage_ids_str = (size(shown) > 0) ? paste(unique(shown), sep="|") else "NA";
		
		line = paste(c(
			asString(sim.cycle),
			"human",
			asString(h.id),
			asString(h.tag),
			asString(getActiveLineageCount(h)),     // PATENT blood-stage
			asString(getSubpatentLineageCount(h)),  // suppressed: present but undetectable
			asString(getDormantLineageCount(h)),    // hypnozoite reservoir GENOTYPE count
			asString(getHypnozoiteReservoirSize(h)), // hypnozoite reservoir TOTAL SIZE
			lineage_ids_str,
			"NA",   // n_transmissible — NA for humans
			"NA",   // mosq_age_days   — NA for humans
			asString(h.getValue("inf_bites"))   // infectious bites received today
			), sep="\t");
		
		rows[k] = line;
		k = k + 1;
		h.setValue("inf_bites", 0);   // reproduction() does not run on a day with no parasite
	}
	
	for (m in mosq)
	{
		lineage_ids_str = (m.individualCount > 0) ?
			paste(unique(m.individuals.getValue("lineage_id")), sep="|") else "NA";
		
		n_trans = countTransmissibleLineages(m); // deterministic count (no RNG) of distinct lineages past EIP
		
		mosq_age = sim.cycle - m.getValue("mosq_birth_tick");
		
		line = paste(c(
			asString(sim.cycle),
			"mosquito",
			asString(m.id),
			asString(m.tag),
			asString(getActiveLineageCount(m)),
			"0",   // moi_subpatent - mosquitoes have no blood stage
			asString(getDormantLineageCount(m)),
			asString(getHypnozoiteReservoirSize(m)), // always 0 - mosquitoes never carry dormant broods
			lineage_ids_str,
			asString(n_trans),
			asString(mosq_age),
			"NA"    // infectious_bites — NA for mosquitoes
			), sep="\t");
		
		rows[k] = line;
		k = k + 1;
	}
	
	if (size(rows) > 0)
		writeFile(OUTDIR + "/state.tsv", rows, append=T);
}

// -----------------------
// MOSQUITO HELPERS
// -----------------------

// Mosquito products are never dormant or subpatent, so for a mosquito getActiveLineageCount()
// counts every lineage it carries.

function (integer$) getActiveLineageCount(o<Subpopulation>$ s)
{
	if (s.individualCount == 0)
		return 0;
	// PATENT blood-stage only. A subpatent clone is present but undetectable, so it is not an
	// episode and does not belong in moi_active. See getTransmissibleLineageCount() for the
	// infectiousness question and getBloodStageLineageCount() for the capacity question;
	// subpatency separates the three (D25 item 7).
	active = s.individuals[s.individuals.getValue("is_dormant") == F &
	                       s.individuals.getValue("is_subpatent") == F];
	if (size(active) == 0)
		return 0;
	return size(unique(active.getValue("lineage_id")));
}

// INFECTIOUSNESS: can this host infect a mosquito at all? Includes subpatent clones whenever
// SUBPATENT_INFECTIVITY > 0; the per-clone weighting is applied in gametocytePool().
function (integer$) getTransmissibleLineageCount(o<Subpopulation>$ s)
{
	if (s.individualCount == 0)
		return 0;
	act = s.individuals[s.individuals.getValue("is_dormant") == F];
	// A host holding only dormant batches has no blood stage, and getValue() below refuses
	// an empty vector.
	if (size(act) == 0)
		return 0;
	if (SUBPATENT_INFECTIVITY <= 0.0)
		act = act[act.getValue("is_subpatent") == F];
	if (size(act) == 0)
		return 0;
	return size(unique(act.getValue("lineage_id")));
}

// CAPACITY: every blood-stage genome present, patent or not. MAX_MOI is about parasite
// burden, not about what a microscope or a mosquito can see.
function (integer$) getBloodStageLineageCount(o<Subpopulation>$ s)
{
	if (s.individualCount == 0)
		return 0;
	act = s.individuals[s.individuals.getValue("is_dormant") == F];
	if (size(act) == 0)
		return 0;
	return size(unique(act.getValue("lineage_id")));
}

// CAPACITY on the day: the blood-stage lineages present, and those of the clones the host gained
// earlier in today's reproduction(), which h.individuals shows only once that is over (D51).
function (integer$) getCapacityLineageCount(o<Subpopulation>$ h)
{
	ids = h.getValue("new_lineages");
	if (h.individualCount > 0)
	{
		act = h.individuals[h.individuals.getValue("is_dormant") == F];
		if (size(act) > 0)
			ids = c(ids, act.getValue("lineage_id"));
	}
	return size(unique(ids));
}

// Suppressed but present: reported as moi_subpatent, and the compartment recrudescence
// comes out of.
function (integer$) getSubpatentLineageCount(o<Subpopulation>$ s)
{
	if (s.individualCount == 0)
		return 0;
	sp = s.individuals[s.individuals.getValue("is_dormant") == F &
	                   s.individuals.getValue("is_subpatent") == T];
	if (size(sp) == 0)
		return 0;
	return size(unique(sp.getValue("lineage_id")));
}

function (integer$) getDormantLineageCount(o<Subpopulation>$ s)
{
	if (s.individualCount == 0)
		return 0;
	dormant = s.individuals[s.individuals.getValue("is_dormant") == T];
	if (size(dormant) == 0)
		return 0;
	// Exclude batches with batch_count == 0. This runs in late(), where such a batch is one
	// that radical cure or MDA emptied this tick, after the early() cleanup had run; the
	// next tick's cleanup removes it. It holds no hypnozoites, so it is not a dormant
	// genotype, and getHypnozoiteReservoirSize() counts it as 0 too.
	dormant = dormant[dormant.getValue("batch_count") > 0];
	if (size(dormant) == 0)
		return 0;
	return size(unique(dormant.getValue("lineage_id")));
}

// NOTE: distinct from getDormantLineageCount() above, which counts unique
// GENOTYPES currently dormant. This sums batch_count across all dormant
// batch objects to give the true hypnozoite RESERVOIR SIZE (total number
// of individual hypnozoites), the quantity White et al. (2014) model for
// each person.
function (integer$) getHypnozoiteReservoirSize(o<Subpopulation>$ s)
{
	if (s.individualCount == 0)
		return 0;
	dormant = s.individuals[s.individuals.getValue("is_dormant") == T];
	if (size(dormant) == 0)
		return 0;
	return sum(dormant.getValue("batch_count"));
}

// -----------------------------------------------------------
// Draw a geometric(mean) batch size, n in {0, 1, 2, ...}, using Eidos's
// built-in rgeom() [White et al. (2014) parameterise the batch by its mean, nu].
// Eidos's rgeom(n, p) already implements exactly the {0,1,2,...}-support
// "number of failures before success" definition we want (same convention
// as R's rgeom, per the Eidos manual) - this is just a thin wrapper
// converting our mean parameterization to the p Eidos expects:
//   mean = (1-p)/p  =>  p = 1 / (1 + mean)
//
// NOTE: parameter type is "fi$" (float-or-integer, singleton), not "if$" -
// the letter order matters here. "if" is tokenized as Eidos's reserved
// if-keyword regardless of context, even inside a type specifier, so
// "if$" fails to parse ("unexpected token '<if>' in type specifier").
// "fi$" means exactly the same union of types but avoids the collision.
// -----------------------------------------------------------
function (integer$) drawHypnozoiteBatchSize(fi$ mean_batch)
{
	mean_batch = asFloat(mean_batch);
	if (mean_batch <= 0)
		return 0;
	p = 1 / (1 + mean_batch);
	return rgeom(1, p)[0];
}

// D19: is case management running right now? Asked once, in decideTreatment(), which every
// case goes through (a bite, a relapse, a recrudescence or an import), so the window cannot
// differ between them; and kept apart from the vector-control window: this gate decides who
// gets drugs, INTERVENTION_* decides biting, and neither may stand in for the other.
function (logical$) caseManagementOn(void)
{
	return (sim.cycle >= TREATMENT_START) & (sim.cycle < TREATMENT_END);
}

// -----------------------------------------------------------
// CASE MANAGEMENT: decide now, apply later.
//
// Treatment is decided where a case ARISES (in reproduction(), or in seedImports() for an
// import) and applied in early() TREATMENT_DELAY days later. Splitting it this way does four
// things a per-genotype flag could not:
//
//   * radical cure reaches the hypnozoite batch seeded by the very bite that caused the case.
//     Applying from reproduction() cannot: SLiM does not make a juvenile visible until the
//     callback ends, so a cure applied there only ever sees OLDER batches.
//   * a detected relapse gets a schizonticide, as any other case does, not only radical cure.
//   * the PATIENT is treated, not one clone. Drugs clear every blood-stage parasite in a
//     person; a flag on a single lineage leaves the host's other clones alive.
//   * treatment is not instantaneous, so a treated case is still infectious until the
//     drugs arrive.
//
// One course at a time per host: a second case while a course is pending does not re-draw.
// -----------------------------------------------------------
function (void) decideTreatment(o<Subpopulation>$ h)
{
	if (!caseManagementOn())
		return;
	if (h.getValue("tx_pending"))
		return;
	if (runif(1) >= BLOODCURE_COVERAGE)
		return;
	h.setValue("tx_pending", T);
	// Each day after the case the course arrives with probability 1/TREATMENT_DELAY, so the
	// delay is geometric with mean TREATMENT_DELAY and at least one day (D24, D32). A course
	// can never be given on the tick the case arises: the parasite became patent that tick, so
	// it cannot yet have caused symptoms or prompted care-seeking. If it could, the same-tick
	// fence in applyTreatment() would CONSUME the course (tx_pending is cleared whether or not
	// anything was treated) and the patient would silently go untreated. TREATMENT_DELAY = 1,
	// the minimum, means the next day.
	h.setValue("tx_tick", sim.cycle + 1 + rgeom(1, 1.0 / TREATMENT_DELAY)[0]);
	h.setValue("tx_liver", runif(1) < RADCURE_COVERAGE);   // nested inside blood-stage treatment
}

// a host-level event (a course given); no single lineage is central to it
function (void) logHostEvent(s$ type, o<Subpopulation>$ h, [i$ n = 1])
{
	logEvent(type, -1, -1, h.id, "NA", "NA", "NA", 0, 0.0, "human", 0, 0, -1, -1, -1, n);
}

// an event about one lineage, carrying its real is_imported rather than a hard-coded 0
function (void) logLineageEvent(s$ type, o<Subpopulation>$ h, o<Individual>$ lin, [i$ n = 1])
{
	logEvent(type, -1, -1, h.id, asString(lin.getValue("lineage_id")), "NA", "NA", 0, 0.0,
		"human", asInteger(lin.getValue("is_dormant")),
		asInteger(lin.getValue("is_imported")), lin.pedigreeID, -1, -1, n,
		lin.getValue("oocyst_id"));
}

// Radical cure. LIVER stage only: it never clears the current blood-stage infection, which
// goes on clearing naturally or by schizonticide. See RADCURE_MODE for the two units.
function (void) applyRadicalCure(o<Subpopulation>$ h, s$ src)
{
	logHostEvent((src == "mda") ? "mda_radcure_given" else "radcure_given", h);
	if (h.individualCount == 0)
		return;
	batches = h.individuals[h.individuals.getValue("is_dormant") == T];
	if (size(batches) == 0)
		return;
	batches = batches[batches.getValue("batch_count") > 0];
	if (size(batches) == 0)
		return;

	if (RADCURE_MODE == "person")
	{
		// all-or-nothing: one draw for the patient, so efficacy does not depend on how many
		// hypnozoites they happen to be carrying
		if (runif(1) < P_RAD_SURVIVAL)
		{
			logHostEvent((src == "mda") ? "mda_radcure_failure" else "radcure_failure", h,
				asInteger(sum(batches.getValue("batch_count"))));
			return;
		}
		for (b in batches)
		{
			logLineageEvent((src == "mda") ? "mda_hypnozoite_clear" else "radcure_hypnozoite_clear",
				h, b, b.getValue("batch_count"));
			b.setValue("batch_count", 0);   // retired; the early() cleanup kills it
		}
	}
	else if (RADCURE_MODE == "hypnozoite")
	{
		// per hypnozoite: each survives independently, so a course can clear PART of a
		// reservoir and leave a subset of genotypes behind
		for (b in batches)
		{
			bc = b.getValue("batch_count");
			n_surv = rbinom(1, bc, asFloat(P_RAD_SURVIVAL));
			if (bc - n_surv > 0)
				logLineageEvent((src == "mda") ? "mda_hypnozoite_clear" else "radcure_hypnozoite_clear",
					h, b, bc - n_surv);
			b.setValue("batch_count", n_surv);
		}
	}
}

// The course itself: every patent blood-stage clone in the host, then the reservoir. An MDA
// course also reaches the host's subpatent clones and the clones that became patent today (D44).
function (void) applyTreatment(o<Subpopulation>$ h, l$ give_liver, s$ src)
{
	logHostEvent((src == "mda") ? "mda_bloodcure_given" else "bloodcure_given", h);
	if (h.individualCount > 0)
	{
		// A case course leaves already-suppressed clones alone: a holder is below patency, so a
		// course given for a different case does not re-roll it. Without this a holder is re-drawn
		// by every later course, emitting a second episode-ending event for a pedigree_id
		// that already has one and tripping the "no blood-stage infection clears twice"
		// audit in inst/validation/audit_events_and_ibd.R. MDA treats everyone it reaches,
		// symptoms or not, so it reaches holders too; see below.
		is_mda = (src == "mda");
		if (is_mda)
			act = h.individuals[h.individuals.getValue("is_dormant") == F];
		else
			act = h.individuals[h.individuals.getValue("is_dormant") == F &
			                    h.individuals.getValue("is_subpatent") == F];
		cleared = c();
		held_cleared = c();
		for (lin in act)
		{
			// A clone that became patent THIS tick cannot yet have caused symptoms, prompted
			// care-seeking or been diagnosed, so a case course cannot reach it: a course landing
			// today treats only the clones that were already patent (D24). Natural clearance in
			// early() follows the same rule (a clone cannot clear on the tick its blood stage began). MDA
			// waits for no symptoms, so it reaches these clones as well (D44).
			// Nested ifs, not `&`: Eidos does not short-circuit, and getValue() on a missing
			// key returns NULL, which cannot be compared.
			if (!is_mda)
			{
				bs = lin.getValue("bloodstage_start_tick");
				if (!isNULL(bs))
					if (bs >= sim.cycle)
						next;
			}
			// MDA reaching a holder (D44): the drugs clear it as they would a patent clone, and its
			// recrudescence goes with it. A holder that survives keeps its schedule: it is not
			// suppressed again, and no event is logged for it.
			if (lin.getValue("is_subpatent"))
			{
				if (runif(1) >= P_BLOODCURE_SURVIVAL)
					held_cleared = c(held_cleared, lin);
				next;
			}
			if (runif(1) >= P_BLOODCURE_SURVIVAL)
				cleared = c(cleared, lin);
			else
			{
				// Draw ONLY when the feature is on. Eidos does not short-circuit, so a bare
				// `runif(1) < P_RECRUD_GIVEN_FAIL` consumes a draw at 0 and shifts the rest of the
				// run's random numbers, although the feature is off.
				suppressed = F;
				if (P_RECRUD_GIVEN_FAIL > 0)
					if (runif(1) < P_RECRUD_GIVEN_FAIL)
						suppressed = T;
				if (suppressed)
				{
					// Suppressed below patency. The re-expansion is scheduled once, here, as a
					// course is, at least one day away, so a clone cannot re-expand on the tick it
					// was suppressed (addCloned also refuses a parent minted in the same tick):
					// geometric with mean MEAN_RECRUD_DELAY by default (D32), 1 + Poisson(mean - 1)
					// for "poisson", round(mean) days for "fixed".
					lin.setValue("is_subpatent", T);
					if (RECRUD_DELAY_DIST == "geometric")
						d_rec = 1 + rgeom(1, 1.0 / MEAN_RECRUD_DELAY)[0];
					else if (RECRUD_DELAY_DIST == "poisson")
						// rpois() refuses a rate of 0, so at the minimum, 1, the delay is one day
						d_rec = 1 + ((MEAN_RECRUD_DELAY > 1.0) ? rpois(1, MEAN_RECRUD_DELAY - 1.0)[0] else 0);
					else
						// asFloat(): round() refuses the integer that -d MEAN_RECRUD_DELAY=4 produces
						d_rec = max(1, asInteger(round(asFloat(MEAN_RECRUD_DELAY))));
					lin.setValue("recrud_tick", sim.cycle + d_rec);
					logLineageEvent("bloodcure_subpatent", h, lin);
				}
				else
					logLineageEvent("bloodcure_persist", h, lin);  // survived at full density
			}
		}
		if (size(cleared) > 0)
		{
			for (lin in cleared)
				logLineageEvent((src == "mda") ? "mda_bloodstage_clear" else "case_bloodstage_clear",
					h, lin);
			sim.treeSeqRememberIndividuals(cleared, permanent=RETAIN_FULL_HISTORY);
			sim.killIndividuals(cleared);
		}
		// not an episode end: a holder's patent episode ended when it was suppressed
		if (size(held_cleared) > 0)
		{
			for (lin in held_cleared)
				logLineageEvent("mda_subpatent_clear", h, lin);
			sim.treeSeqRememberIndividuals(held_cleared, permanent=RETAIN_FULL_HISTORY);
			sim.killIndividuals(held_cleared);
		}
	}
	if (give_liver)
		applyRadicalCure(h, src);
	h.tag = (getTransmissibleLineageCount(h) > 0) ? INFECTED else SUSCEPTIBLE;
}

// mean hypnozoite batch size per infectious bite, including the resurgence boost.
function (float$) effectiveNuBatch(void)
{
	return asFloat((sim.cycle >= RESURGENCE_TRIGGER_TICK) ?
		NU_HYPNOZOITE_BATCH * NU_HYPNOZOITE_BATCH_BOOST else NU_HYPNOZOITE_BATCH);
}

// zero-truncated count (support 1,2,...) with PRE-truncation mean `lambda` and
// optional overdispersion `k`:
//   k <= 0 -> Poisson (via Eidos' built-in rztpois; realised mean lambda/(1-exp(-lambda)))
//   k >  0 -> negative binomial, var = lambda + lambda^2/k, drawn as a Gamma-Poisson
//             mixture and zero-truncated by rejection.
// lambda <= 0 returns 1 (the degenerate limit) = the single-oocyst / single-product
// behaviour, which is the shipped default.
// Zero-TRUNCATION (not inflation) is the right family here: P_TRANS_HV / P_TRANS_VH already
// decide whether the event happens, so the zeros are modelled upstream.
// NOTE on the "fi$" (float-or-integer) parameter types: values arriving via -d from R may be
// typed INTEGER (e.g. 0 rather than 0.0), so declaring f$ here would reject them. "fi$" accepts
// both; the letter order matters ("if$" tokenizes as the if-keyword). Same idiom as
// drawHypnozoiteBatchSize() above.
function (integer$) drawZTCount(fi$ lambda, [fi$ k = 0.0])
{
	lambda = asFloat(lambda); k = asFloat(k);
	if (lambda <= 0)
		return 1;
	if (k <= 0)
		return rztpois(1, lambda)[0];
	for (attempt in seqLen(10000))          // rejection; terminates a.s. since P(0) < 1
	{
		// With a small shape k the gamma draw can underflow to exactly 0.0, which rpois() refuses.
		// A zero rate gives a zero count, which the truncation rejects anyway. (initialize() bounds
		// lambda and k, so the draw cannot overflow.)
		g = rgamma(1, lambda, k)[0];
		if (!(g > 0.0))
			next;
		n = rpois(1, g)[0];
		if (n > 0)
			return n;
	}
	// An uptake gets here with probability P(0)^10000: 37% where a positive count is 1 draw in
	// 1e4 (LAMBDA_OOCYSTS about 1e-4, at any k), and below 1e-6 above a LAMBDA_OOCYSTS of about
	// 3e-3. The count is then drawn exactly, by inversion: the zero-truncated negative binomial has
	// P(x + 1) / P(x) = (x + k) / (x + 1) * p with p = lambda / (k + lambda). Wherever an uptake
	// gets here with a probability above 1e-12 (lambda below about 0.015 at k = 0.001), p is at
	// most about 0.94, so at most about 500 terms carry all but about 1e-16 of the mass.
	p = lambda / (k + lambda);
	w = 1.0;
	weights = 1.0;
	total = 1.0;
	x = 1;
	while (T)
	{
		ratio = (x + k) / (x + 1) * p;
		w = w * ratio;
		if (w < 1e-17 * total & ratio < 1)
			break;
		weights = c(weights, w);
		total = total + w;
		x = x + 1;
	}
	return sample(seqLen(size(weights)) + 1, 1, weights = weights)[0];
}

// -----------------------------------------------------------
// D17: IMPORT SEEDING, and the one-tick deferral of the second compartment.
//
// Imports are seeded here, in early(), not in reproduction(), which SLiM calls once per
// EXISTING individual: with zero parasites alive it never runs, so an import seeded there
// could never reach a naive population or re-seed a run that reached elimination.
//
// addEmpty()/addCloned() are reproduction()-only, so the genome is minted HERE with
// sim.addSubpop() - the same idiom the founder lineages use at tick 1 - and moved into
// the host with takeMigrants(), which is legal anywhere and preserves pedigreeID, tag
// and every setValue(). The scratch subpopulation is removed in this same callback: it
// is a birthplace, not a residence. Subpopulation ids cannot be reused, so
// NEXT_SCRATCH_SUBPOP burns one id per import-tick.
//
// One inoculation delivers ONE sporozoite population, so the blood-stage infection and
// the hypnozoite batch must be the SAME genome, not two unrelated roots (D17). A genome
// minted this tick cannot be cloned until it is visible ("parent must be visible in a
// subpopulation"), so when an import takes in both compartments the second is queued and
// cloned next tick by the drain in reproduction(). The migrated genome takes whichever
// compartment exists, so a P_PRIMARY failure (hypnozoites but no blood stage) needs no
// special case - there is simply nothing to clone.
// -----------------------------------------------------------
function (void) seedImports(o<Subpopulation> import_hosts)
{
	n = size(import_hosts);
	if (n == 0)
		return;

	// Roll the outcomes BEFORE minting anything: an inoculation that takes in neither
	// compartment must not leave a genome with nowhere to go.
	has_primary = (runif(n) < P_PRIMARY);
	batch_size  = integer(0);
	inoc_ids    = integer(0);
	for (i in seqLen(n))
	{
		batch_size = c(batch_size, drawHypnozoiteBatchSize(effectiveNuBatch()));
		defineGlobal("INOCULATION_ID", INOCULATION_ID + 1);
		inoc_ids = c(inoc_ids, INOCULATION_ID);
	}
	makes = (has_primary | (batch_size > 0));

	for (i in seqLen(n))
	{
		if (makes[i])
			next;
		logEvent("vh_inoculation_import_no_take", inoc_ids[i], -1, import_hosts[i].id,
			"NA", "NA", "NA", 0, 0.0, "human", -1, 1);
	}

	n_make = sum(makes);
	if (n_make == 0)
		return;

	scratch = sim.addSubpop(NEXT_SCRATCH_SUBPOP, n_make);   // ONE scratch for the whole tick
	defineGlobal("NEXT_SCRATCH_SUBPOP", NEXT_SCRATCH_SUBPOP + 1);
	genomes = scratch.individuals;

	k = 0;
	for (i in seqLen(n))
	{
		if (!makes[i])
			next;
		g = genomes[k]; k = k + 1;
		h = import_hosts[i];
		as_batch = !has_primary[i];        // no blood stage -> the migrant IS the batch

		// a lineage of its own, from no meiosis we simulated (it happened in the source)
		setHostGenome(g, birth=sim.cycle, lineage=g.pedigreeID, oocyst=-1, brood=-1, founder=T,
			inoc_tick=sim.cycle, inoc_id=inoc_ids[i], imported=T, activation=NULL,
			batch=(as_batch ? batch_size[i] else 0), color=(as_batch ? "turquoise4" else "goldenrod2"));

		h.takeMigrants(g);                 // legal outside reproduction(); keeps all state

		detected_case = -1;
		if (!as_batch)
		{
			h.tag = INFECTED;
			// Detection and case management for an imported case. Gated on the
			// case-management window, which is independent of vector control.
			detected_case = asInteger(runif(1) < P_DETECT_PRIMARY);
		}

		logEvent("vh_inoculation_import", inoc_ids[i], -1, h.id,
			asString(g.getValue("lineage_id")), "NA", "NA", 0, 0.0, "human",
			as_batch ? 1 else 0, 1,
			g.pedigreeID,
			-1,                            // D17: logged parent stays -1. The ARG records the
			-1,                            // primary->batch clone edge, but NOTHING inside the
			                               // simulation is the parent of an import, and writing
			                               // the primary here would let anyone reconstructing
			                               // transmission infer an intra-host blood->liver
			                               // event that never happened.
			as_batch ? batch_size[i] else 1,
			-1, detected_case);

		// queue the SECOND compartment when the inoculation takes in both
		if (has_primary[i] & batch_size[i] > 0)
		{
			defineGlobal("PENDING_BATCH_PED",  c(PENDING_BATCH_PED,  g.pedigreeID));
			defineGlobal("PENDING_BATCH_N",    c(PENDING_BATCH_N,    batch_size[i]));
			defineGlobal("PENDING_BATCH_INOC", c(PENDING_BATCH_INOC, inoc_ids[i]));
		}

		// An imported case goes through the same decide step as any other: the course is
		// scheduled here and applied in early(), which is what lets radical cure reach the
		// hypnozoite batch this very arrival seeds.
		if (detected_case == 1)
			decideTreatment(h);
	}
	scratch.removeSubpopulation();
	vcat("✈️ Imports seeded on tick " + sim.cycle + ": " + n_make + " (" +
		size(PENDING_BATCH_PED) + " batch(es) queued for next tick)");
}

// -----------------------------------------------------------
// Decoupled primary-infection / hypnozoite-batch establishment for ONE transmitted
// genotype delivered by a mosquito bite (White et al. 2014 model). `source` is the
// mosquito genotype being inoculated; both compartments are clones of it, so they are
// IBD 1 to each other and to it.
//
// Independently:
//   (1) P_PRIMARY -> an active blood-stage infection
//   (2) the genotype's share of the bite's hypnozoite batch, which
//       inoculateMosquitoToHuman() draws -> a dormant "batch" object carrying
//       batch_count = that share (only made if it is above 0)
// Both, either, or neither can happen. Returns the lineage_id(s) actually established
// (0, 1 or 2 entries) for caller-side logging.
//
// Callable ONLY from reproduction(), since it calls addCloned(). Imports do not come
// through here - they have no `source` to clone and are seeded by seedImports().
// -----------------------------------------------------------
function (integer) establishInfectionOutcome(
	o<Subpopulation>$ h,
	No<Individual>$ source,
	i$ inoculation_id,
	i$ mosq_id,
	i$ detected,                // detection is drawn ONCE PER EPISODE by the caller, not per
	                            // genotype: one bite delivering two genotypes is one case
	i$ batch_size)              // this genotype's share of the per-BITE hypnozoite batch
{
	// A human infection inherits the meiosis (oocyst) and the co-hatching brood of the
	// mosquito genotype that seeded it.
	inf_oocyst = source.getValue("oocyst_id");
	inf_brood  = source.getValue("brood_id");

	has_primary = (runif(1) < P_PRIMARY);
	// read by inoculateMosquitoToHuman(): only a bite that makes a blood stage is a case (D36)
	defineGlobal("LAST_HAS_PRIMARY", has_primary);
	has_batch   = (batch_size > 0);
	
	established_lineage_ids = integer(0);
	
	if (!has_primary & !has_batch)
	{
		logEvent(
			"vh_inoculation_no_take",
			inoculation_id, mosq_id, h.id,
			asString(source.getValue("lineage_id")),
			"NA", "NA", 0, 0.0, "human",
			-1, // is_dormant: N/A, nothing established
			0
			);
		return established_lineage_ids;
	}
	
	// ---------------- Primary (active) infection ----------------
	if (has_primary)
	{
		new_active = h.addCloned(source);
		h.setValue("new_lineages", c(h.getValue("new_lineages"), source.getValue("lineage_id")));
		
		// a bite never founds a lineage; the seed or import did
		setHostGenome(new_active, birth=source.getValue("brood_birth_tick"),
			lineage=source.getValue("lineage_id"), oocyst=inf_oocyst, brood=inf_brood, founder=F,
			inoc_tick=sim.cycle, inoc_id=inoculation_id, imported=F, activation=NULL, batch=0,
			color="goldenrod2");
		h.tag = INFECTED;

		logEvent(
			"vh_inoculation",
			inoculation_id, mosq_id, h.id,
			asString(new_active.getValue("lineage_id")),
			"NA", "NA", 0, 0.0, "human",
			0, 0,
			new_active.pedigreeID,
			source.pedigreeID,
			-1, 1, inf_oocyst, detected
			);

		established_lineage_ids = c(established_lineage_ids, new_active.getValue("lineage_id"));
	}
	
	// ---------------- Hypnozoite batch ----------------
	if (has_batch)
	{
		// One inoculation delivers ONE sporozoite population, so the blood-stage infection and
		// the hypnozoite batch are the SAME genome: both are clones of `source`, giving IBD 1
		// between them. (Imports reach the same result by a different route - they have no
		// `source` to clone, so seedImports() mints the genome and the second compartment is
		// cloned from it one tick later.)
		new_batch = h.addCloned(source);

		batch_lineage_id = source.getValue("lineage_id");
		
		setHostGenome(new_batch, birth=source.getValue("brood_birth_tick"), lineage=batch_lineage_id,
			oocyst=inf_oocyst, brood=inf_brood, founder=F, inoc_tick=sim.cycle, inoc_id=inoculation_id,
			imported=F, activation=NULL, batch=batch_size, color="turquoise4");
		
		logEvent(
			"vh_inoculation",
			inoculation_id, mosq_id, h.id,
			asString(batch_lineage_id),
			"NA", "NA", 0, 0.0, "human",
			1, 0,
			new_batch.pedigreeID,
			source.pedigreeID,
			-1,
			batch_size, // n_hypnozoites
			inf_oocyst
			);
		
		established_lineage_ids = c(established_lineage_ids, batch_lineage_id);
	}

	return established_lineage_ids;
}

// Every field a new genome in a host carries, set here for each way one enters a host - a
// founder, a founder's clonal copy, an import, a bite's genotype, a relapse, a recrudescence and
// the hypnozoite batch of an import or a bite - so that no route can leave one unset.
//   birth             the tick its brood was born (a bite's oocyst, or the day it was seeded)
//   lineage           its genetic identity, the pedigreeID of its lineage's founder. It is stored
//                     as a raw INTEGER everywhere in this script and stringified with asString()
//                     only at the logEvent() boundary: unique() and getValue() elsewhere assume
//                     a homogeneous integer type and break on a mixed one.
//   oocyst, brood     the meiosis and co-hatching brood it came from; -1 for none we simulated
//   founder           recorded as brood_founder, which nothing reads: T for a genome seeded in
//                     the host (a founder, a founder's copy, an import), F for one cloned from a
//                     genome in a mosquito or the host
//   inoc_tick/inoc_id when and by which inoculation it entered a host (inoc_id -1 for a founder)
//   imported          whether its infection was acquired elsewhere
//   activation        the tick it woke from a hypnozoite or re-expanded from subpatency, or NULL
//   batch             0 for a blood-stage clone, patent from this tick; above 0 for a dormant
//                     batch of that many hypnozoites, at latency stage K_LATENCY
// brood_ready_tick, the end of a mosquito product's EIP (tagMosqProduct()), is NULL in a host.
// x, y and z are 0, as for a mosquito product: SLiM writes them into the tree sequence's individuals
// table even in a non-spatial model and leaves them undefined until set, so without this that
// table could differ between two runs of one seed (D77).
function (void) setHostGenome(o<Individual>$ g, i$ birth, i$ lineage, i$ oocyst, i$ brood,
	l$ founder, i$ inoc_tick, i$ inoc_id, l$ imported, Ni$ activation, i$ batch, s$ color)
{
	g.x = 0.0;
	g.y = 0.0;
	g.z = 0.0;
	g.setValue("brood_birth_tick", birth);
	g.setValue("lineage_id", lineage);
	g.setValue("oocyst_id", oocyst);
	g.setValue("brood_id", brood);
	g.setValue("brood_founder", founder);
	g.setValue("inoculation_tick", inoc_tick);
	g.setValue("inoculation_id", inoc_id);
	g.setValue("activation_tick", activation);
	g.setValue("brood_ready_tick", NULL);
	g.setValue("is_imported", imported);
	g.setValue("is_subpatent", F);
	if (batch > 0)
	{
		g.setValue("is_dormant", T);
		g.setValue("bloodstage_start_tick", NULL);
		g.setValue("gametocyte_ready_tick", NULL);
		g.setValue("latency_stage", K_LATENCY);
		g.setValue("batch_count", batch);
	}
	else
	{
		g.setValue("is_dormant", F);
		g.setValue("bloodstage_start_tick", sim.cycle);
		g.setValue("gametocyte_ready_tick", sim.cycle + GAMETOCYTE_DELAY);
		g.setValue("latency_stage", 0);
		g.setValue("batch_count", NULL);
	}
	g.color = color;
}

// A clone of `parent`, a genome already in the host - a relapse or a recrudescence (`activation`
// is the tick it woke or re-expanded), or an import's hypnozoite batch - keeps the parent's
// origin: its brood, lineage, meiosis, inoculation and imported origin (an imported relapse is a
// distinct truth category). It never founds its lineage.
function (void) setHostClone(o<Individual>$ g, o<Individual>$ parent, Ni$ activation, i$ batch, s$ color)
{
	setHostGenome(g, birth=parent.getValue("brood_birth_tick"), lineage=parent.getValue("lineage_id"),
		oocyst=parent.getValue("oocyst_id"), brood=parent.getValue("brood_id"), founder=F,
		inoc_tick=parent.getValue("inoculation_tick"), inoc_id=parent.getValue("inoculation_id"),
		imported=parent.getValue("is_imported"), activation=activation, batch=batch, color=color);
}

// set the standard tags on a freshly-created mosquito-stage oocyst product, with x, y and z 0 as in
// setHostGenome() (D77).
function (void) tagMosqProduct(o<Individual>$ prod, i$ lineage, i$ oocyst, i$ brood, s$ color, [f$ spz_weight = 1.0])
{
	prod.x = 0.0;
	prod.y = 0.0;
	prod.z = 0.0;
	prod.setValue("spz_weight", spz_weight);      // share of the oocyst's sporozoite output this Individual represents (4 = a selfed oocyst's 4 identical products)
	prod.setValue("brood_birth_tick", sim.cycle); // oocyst created now
	prod.setValue("inoculation_tick", NULL);      // not yet in a human
	prod.setValue("inoculation_id", -1);          // not yet inoculated
	prod.setValue("lineage_id", lineage);
	prod.setValue("oocyst_id", oocyst);
	prod.setValue("brood_id", brood);
	prod.setValue("brood_founder", T);
	prod.setValue("brood_ready_tick", sim.cycle + EIP_DAYS);
	prod.setValue("is_dormant", F);
	prod.setValue("is_subpatent", F);
	prod.setValue("is_imported", F);
	prod.setValue("bloodstage_start_tick", NULL); // NA in mosquito
	prod.setValue("gametocyte_ready_tick", NULL); // NA in mosquito
	prod.setValue("activation_tick", NULL);
	prod.setValue("latency_stage", 0);
	prod.color = color;
}

// SELFING oocyst - one product, genome + lineage INHERITED from the single
// parent (clonal). Inheriting the lineage (vs minting a fresh one) keeps clonal
// duplicates from being counted as distinct genotypes in COI.
function (integer$) seedSelfedOocyst(o<Subpopulation>$ m, o<Individual>$ parent, s$ color, i$ oocyst, i$ brood)
{
	prod = m.addCloned(parent);
	lineage = parent.getValue("lineage_id");
	tagMosqProduct(prod, lineage, oocyst, brood, color, 4.0); // stands in for all 4 (identical) meiotic products
	return lineage;
}

// OUTCROSSING oocyst - a full meiotic TETRAD of 4 haploid products sharing one oocyst_id, by
// per-chromosome four-strand meiosis (D34, D41). The zygote's two genomes replicate into four
// chromatids per chromosome (two from each parent). Chiasmata fall at a Poisson(2d) set of points
// per bivalent, the union of two gamete-rate draws, so that each product keeps the map length d;
// each chiasma joins a chromatid carrying parent1's sequence there and one carrying parent2's,
// each chosen at random (no chromatid interference). Meiosis I then sends the two chromatids that
// carry the same parent at the chromosome's centromere to the same pole, products 0 and 1 or
// products 2 and 3, the pole drawn independently for each chromosome; meiosis II gives one to
// each product of that pole. So products 0 and 1, and 2 and 3, are meiosis II sisters on every
// chromosome. A product with no switch at all is a whole copy of its starting parent and inherits
// that parent's lineage (keeps lineage_id == genome identity); every other product is a fresh
// lineage.
function (integer) seedTetrad(o<Subpopulation>$ m, o<Individual>$ parent1, o<Individual>$ parent2, s$ color, i$ oocyst, i$ brood)
{
	n_chr = size(CHROM_STARTS);
	chi = c(sim.chromosome.drawBreakpoints(), sim.chromosome.drawBreakpoints());
	// within-chromosome chiasmata only (the junction draws are not chiasmata), once each
	chi = sort(unique(chi[match(chi, CHROM_STARTS) < 0], preserveOrder=F));
	chr_of = findInterval(chi, CHROM_STARTS);
	breaks = Dictionary();
	for (k in 0:3)
		breaks.setValue(asString(k), integer(0));
	start_parent = integer(4);   // 0: product k starts on parent1's genome, 1: on parent2's
	last_parent = integer(4);    // the parent product k ends the previous chromosome on
	for (ch in 0:(n_chr - 1))
	{
		// chromatids 0, 1 start on parent1 and 2, 3 on parent2; on_parent tracks each one's
		// current parent as the chiasmata along this chromosome swap them, and at_cen keeps its
		// parent at the centromere (a chiasma at the centromere's own base counts before it)
		xs = chi[chr_of == ch];
		n_x = size(xs);
		on_parent = c(0, 0, 1, 1);
		at_cen = NULL;
		// the parent1-side and parent2-side chromatid of each chiasma; appended rather than
		// assigned by index, which Eidos does in place (an indexed assignment copies the vector)
		ca = integer(0);
		cb = integer(0);
		for (j in seqLen(n_x))
		{
			if (isNULL(at_cen) & xs[j] > CHROM_CENTROMERES[ch])
				at_cen = on_parent;
			a = sample(which(on_parent == 0), 1);
			b = sample(which(on_parent == 1), 1);
			ca = c(ca, a);
			cb = c(cb, b);
			on_parent[a] = 1;
			on_parent[b] = 0;
		}
		if (isNULL(at_cen))
			at_cen = on_parent;
		// meiosis I: the pair on parent1 at the centromere goes to products 0, 1 or to 2, 3;
		// meiosis II: each pair in random order. Chromatid to_product[k] goes to product k.
		on1 = sample(which(at_cen == 0), 2);
		on2 = sample(which(at_cen == 1), 2);
		to_product = (sample(0:1, 1) == 0) ? c(on1, on2) else c(on2, on1);
		for (k in 0:3)
		{
			s = to_product[k];
			sw = xs[ca == s | cb == s];   // where chromatid s changes parent
			first = (s < 2) ? 0 else 1;
			bk = breaks.getValue(asString(k));
			if (ch == 0)
				start_parent[k] = first;
			else if (first != last_parent[k])
				bk = c(bk, CHROM_STARTS[ch]);   // the product changes parent at the junction
			bk = c(bk, sw);
			breaks.setValue(asString(k), bk);
			last_parent[k] = integerMod(first + size(sw), 2);
		}
	}
	lineages = integer(0);
	for (k in 0:3)
	{
		bk = breaks.getValue(asString(k));
		if (start_parent[k] == 0)
		{
			prod = m.addRecombinant(parent1.haplosomes, parent2.haplosomes, bk, NULL, NULL, NULL, parent1=parent1, parent2=parent2, randomizeStrands=F);
			copy_of = parent1;
		}
		else
		{
			prod = m.addRecombinant(parent2.haplosomes, parent1.haplosomes, bk, NULL, NULL, NULL, parent1=parent2, parent2=parent1, randomizeStrands=F);
			copy_of = parent2;
		}
		is_copy = (size(bk) == 0);
		lineage = is_copy ? copy_of.getValue("lineage_id") else prod.pedigreeID;
		tagMosqProduct(prod, lineage, oocyst, brood, is_copy ? "indianred3" else color);
		lineages = c(lineages, lineage);
	}
	return lineages;
}

// -------------------------------------------------------
// MODEL STRUCTURE: 1 SLiM Individual = 1 parasite genome = 1 lineage member.
//   - An outcrossing meiosis (one oocyst) yields a TETRAD of 4 products, each recombined by
//     per-chromosome four-strand meiosis, sharing one oocyst_id (see seedTetrad()).
//   - A selfing meiosis yields one clonal product (seedSelfedOocyst()).
//   - lineage_id is the genetic identity (clonal group); COI counts distinct lineage_id.
//   - oocyst_id groups tetrad sibs; brood_id groups co-hatching oocysts of one uptake.
//   - Selfing vs outcrossing is NOT decided anywhere: each oocyst draws its two gametes
//     independently and uniformly from the gametocyte pool and outcrosses iff they happen
//     to differ. Simpson (1 - sum p_i^2) is the resulting MARGINAL, computed only to be
//     logged as p_outcross - see computeOutcrossingProb().
//   - Multiple oocysts per uptake, sharing one brood_id, is implemented: LAMBDA_OOCYSTS
//     (with K_OOCYSTS for overdispersion).
// -------------------------------------------------------

// all mosquito-stage Individuals whose oocyst has completed the EIP.
function (o<Individual>) readyMosqProducts(o<Subpopulation>$ m)
{
	if (m.individualCount == 0)
		return m.individuals;
	inds = m.individuals;
	keep = logical(size(inds));
	for (i in seqAlong(inds))
	{
		rt = inds[i].getValue("brood_ready_tick");
		if (!isNULL(rt))
			keep[i] = (sim.cycle >= rt);
	}
	return inds[keep];
}

// deterministic count of distinct transmissible lineages (for state.tsv; consumes no RNG).
function (integer$) countTransmissibleLineages(o<Subpopulation>$ m)
{
	ready = readyMosqProducts(m);
	if (size(ready) == 0)
		return 0;
	return size(unique(ready.getValue("lineage_id")));
}

// draw the genotypes delivered by ONE infectious bite.
// n ~ zero-truncated(LAMBDA_SPOROZOITES) products, sampled WITH replacement and weighted by
// spz_weight (so a selfed oocyst counts as its 4 identical products), from every product past
// the EIP. Repeat draws of the same lineage COLLAPSE to one Individual per distinct lineage -
// a bite delivers genotypes, not duplicate objects (duplicates would inflate that lineage's
// weight in the recipient's gametocyte pool). Returns empty if nothing has completed the EIP.
function (o<Individual>) sampleTransmissibleMosqBroods(o<Subpopulation>$ m)
{
	ready = readyMosqProducts(m);
	if (size(ready) == 0)
		return ready;

	w = ready.getValue("spz_weight");   // tagMosqProduct() sets it on every product

	draws = sample(ready, drawZTCount(LAMBDA_SPOROZOITES), replace=T, weights=w);

	// one Individual per distinct lineage, in draw order
	lin = draws.getValue("lineage_id");
	first = integer(0);
	seen = integer(0);
	for (i in seqAlong(draws))
	{
		if (any(seen == lin[i]))
			next;
		seen = c(seen, lin[i]);
		first = c(first, i);
	}
	return draws[first];
}

function (integer) inoculateMosquitoToHuman(
	o<Individual> broods,
	o<Subpopulation>$ h,
	i$ mosq_id,
	i$ inoculation_id)
{
	new_lineage_ids = integer(0);

	// ONE hypnozoite batch per infectious BITE (White et al. 2014 parameterise nu per
	// bite, not per genotype), split uniformly among the k co-inoculated genotypes - so
	// co-transmission does not inflate the reservoir. With one genotype (k == 1, as at the
	// default LAMBDA_SPOROZOITES = 0) the whole batch goes to it.
	k = size(broods);
	det = asInteger(runif(1) < P_DETECT_PRIMARY);   // one draw for the BITE, not per genotype
	bite_batch = drawHypnozoiteBatchSize(effectiveNuBatch());
	shares = integer(k);
	if (k == 1)
		shares[0] = bite_batch;
	else if (bite_batch > 0)
		shares = tabulate(sample(0:(k - 1), bite_batch, replace=T), k - 1);

	any_primary = F;
	for (i in seqLen(k))
	{
		established = establishInfectionOutcome(h, broods[i], inoculation_id, mosq_id, det, shares[i]);

		new_lineage_ids = c(new_lineage_ids, established);
		any_primary = any_primary | LAST_HAS_PRIMARY;
	}
	// One bite is ONE episode, so one detection draw and at most one course - even when the
	// bite delivered several genotypes. Drawing per genotype let a single bite be "detected
	// and treated" for one of its genotypes and not the other. A bite that seeds only
	// hypnozoites makes no blood stage, so it is no case and gets no course (D36).
	if (det == 1 & any_primary)
		decideTreatment(h);
	if (getTransmissibleLineageCount(h) > 0)
		h.tag = INFECTED;
	
	return new_lineage_ids;
}

// The transmissible GAMETOCYTE POOL of a human: its blood-stage clones that have matured
// (sim.cycle >= gametocyte_ready_tick) AND carry gametocytes (per-infection
// Bernoulli(P_GAMETOCYTE), rolled once and cached in is_gametocytemic), a subpatent one only
// with probability SUBPATENT_INFECTIVITY. At GAMETOCYTE_DELAY = 0 and P_GAMETOCYTE = 1, the
// defaults, every clone that passes the subpatency gate is in it, by a fast path that draws no
// number.
function (o<Individual>) gametocytePool(o<Subpopulation>$ h)
{
	if (h.individualCount == 0)
		return h.individuals[integer(0)];
	active = h.individuals[h.individuals.getValue("is_dormant") == F];
	if (size(active) == 0)
		return active;
	// Subpatency gate FIRST, above the identity fast path: at the shipped defaults
	// (GAMETOCYTE_DELAY 0, P_GAMETOCYTE 1) that path returns early, so a gate placed inside
	// the loop below would be dead code in every default run.
	if (SUBPATENT_INFECTIVITY <= 0.0)
		active = active[active.getValue("is_subpatent") == F];
	else if (SUBPATENT_INFECTIVITY < 1.0)
	{
		keep_sp = logical(size(active));
		for (i in seqAlong(active))
		{
			// branch rather than `|`: Eidos evaluates both sides, so an or-expression would
			// burn a draw on every PATENT clone and make the stream depend on how many of
			// them there are.
			if (active[i].getValue("is_subpatent") == F)
				keep_sp[i] = T;
			else
				keep_sp[i] = (runif(1) < SUBPATENT_INFECTIVITY);
		}
		active = active[keep_sp];
	}
	if (size(active) == 0)
		return active;
	if ((GAMETOCYTE_DELAY == 0) & (P_GAMETOCYTE >= 1.0))
		return active;                              // identity gating (no RNG)
	keep = logical(size(active));
	for (i in seqAlong(active))
	{
		ind = active[i];
		grt = ind.getValue("gametocyte_ready_tick");
		if (!isNULL(grt) & (sim.cycle < grt))
			next;                                   // not yet transmissible (immature)
		gflag = ind.getValue("is_gametocytemic");
		if (isNULL(gflag))                          // first eligibility: roll + cache
		{
			gflag = (runif(1) < P_GAMETOCYTE);
			ind.setValue("is_gametocytemic", gflag);
		}
		keep[i] = gflag;
	}
	return active[keep];
}

// DIAGNOSTIC ONLY - this value decides nothing.
//
// Simpson's index (1 - sum p_i^2) over distinct lineages in the gametocyte pool. It is the
// EXPECTED outcrossing rate for a pool of this composition, written to the p_outcross column
// of the event log so the realised rate can be checked against it. The realised outcome is
// produced in seedBroodFromHuman() by drawing two gametes independently and uniformly per
// oocyst, which reproduces this as a marginal AND gives the correct pairing P(i,j) ~ p_i*p_j
// (Wong et al. 2018). Rolling Bernoulli(1 - Simpson) and then picking two DISTINCT lineages
// would match the marginal but not the pairing.
function (float$) computeOutcrossingProb(o<Individual> active)
{
	if (size(active) == 0)
		return 0.0;

	lineage_ids = active.getValue("lineage_id");
	unique_lineages = unique(lineage_ids);
	K = size(unique_lineages);
	
	if (K <= 1)
		return 0.0;  // only one genetically distinct brood: SELFING
	
	N = size(lineage_ids);
	sum_sq = 0.0;
	
	for (bid in unique_lineages)
	{
		n_i = sum(lineage_ids == bid);
		p_i = n_i / N;
		sum_sq = sum_sq + p_i^2;
	}
	
	return 1.0 - sum_sq;
}

// mosquito acquires a brood from a human. One uptake = one co-hatching brood of one or more
// oocysts (LAMBDA_OOCYSTS), each its own meiosis: an outcrossed oocyst gives a tetrad, a selfed
// one a clonal product.
function (integer) seedBroodFromHuman(
	o<Subpopulation>$ m,
	o<Subpopulation>$ h,
	i$ mosq_id,
	i$ human_id)
{
	// a mosquito can only acquire parasites from the transmissible gametocyte
	// pool. If the human has active blood-stage infection but no mature gametocytes yet
	// (within GAMETOCYTE_DELAY, or non-gametocytemic), the uptake fails (no brood seeded).
	active = gametocytePool(h);
	if (size(active) == 0)
		return integer(0);

	// EXPECTED outcrossing rate for this pool - logged only (the p_outcross column); the
	// REALISED outcome emerges from the independent gamete draws below and is recorded
	// per oocyst by is_recombinant / the hv_uptake_* event type.
	p_outcross = computeOutcrossingProb(active);

	// one uptake -> ONE co-hatching brood of n_oocysts oocysts (shared brood_id);
	// each oocyst is its own meiosis (own oocyst_id) and draws its OWN gamete pair.
	defineGlobal("NEXT_BROOD_ID", NEXT_BROOD_ID + 1); brood = NEXT_BROOD_ID;
	n_oocysts = drawZTCount(LAMBDA_OOCYSTS, K_OOCYSTS);
	out = integer(0);

	for (k in seqLen(n_oocysts))
	{
		defineGlobal("NEXT_OOCYST_ID", NEXT_OOCYST_ID + 1); oocyst = NEXT_OOCYST_ID;

		// Two gametes drawn INDEPENDENTLY and UNIFORMLY (with replacement) from the gametocyte
		// pool. This reproduces P(outcross) = 1 - sum(p_i^2) as a marginal AND gives the correct
		// pairing P(i,j) ~ p_i*p_j (Wong et al. 2018), which "roll outcross, then pick two
		// DISTINCT lineages" would not.
		gam = sample(active, 2, replace=T);
		lin1 = gam[0].getValue("lineage_id");
		lin2 = gam[1].getValue("lineage_id");

		if (lin1 != lin2)
		{
			out = c(out, seedTetrad(m, gam[0], gam[1], "magenta4", oocyst, brood));

			logEvent(
				"hv_uptake_recombinant",
				-1, mosq_id, human_id,
				"NA",                             // a tetrad has 4 lineages, not one
				asString(lin1), asString(lin2),
				1, p_outcross, "mosquito", 0, 0,
				-1,
				gam[0].pedigreeID,
				gam[1].pedigreeID,
				1, oocyst
				);

			vcat("Tetrad (oocyst " + oocyst + ", brood " + brood + ") in mosq " + m.id +
				" from lineages " + lin1 + " x " + lin2 + " (E[P_outcross]=" + p_outcross + ")");
		}
		else
		{
			new_lineage = seedSelfedOocyst(m, gam[0], "indianred3", oocyst, brood);
			out = c(out, new_lineage);

			logEvent(
				"hv_uptake_clonal",
				-1, mosq_id, human_id,
				asString(new_lineage),
				asString(lin1),
				"NA",
				0, p_outcross, "mosquito", 0, 0,
				-1,
				gam[0].pedigreeID,
				-1,
				1, oocyst
				);

			vcat("Selfed oocyst (oocyst " + oocyst + ", brood " + brood + ") in mosq " + m.id +
				" (E[P_outcross]=" + p_outcross + ", MOI=" + getActiveLineageCount(h) + ")");
		}
	}

	return out;
}